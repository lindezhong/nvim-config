# Plugin lock file (each machine syncs its own versions)
lazy-lock.json

# Vim/Neovim swap files (created when editing files)
*.swp
*.swo
*.swn

# Vim/Neovim backup files
*~
*.bak

# Vim/Neovim undo files (persistent undo history)
*.un~

# Neovim shada file (shared data: marks, registers, command history)
*.shada

# Plugin data directories (auto-generated by lazy.nvim and mason)
plugin/

# Neovim log file
log

# OS generated files
.DS_Store
Thumbs.db
