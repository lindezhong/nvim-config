# #jq
# -R : convert json to a string
# -r : convert a string to json (normalized).
#      echo '{"k": "v"}' | jq -r ".k" # output: v
#      echo '{"k": "v"}' | jq ".k" # output: "v"
# -s : convert newlines to '\n'; use with -R so json-to-string produces a single line
snippet jqGet jq get a field, key passed as a parameter; key structure: .firstLevelKey.secondLevelKey (separated by '.'), key can be a variable
	${3:var}=\$(echo \$${1:json variable} | jq -r --arg key  "${2:key}" '.[\$key]')
	$0

snippet jqArrFor jq iterate over a jq array/list; the json list must be in [] format
	${1:length}=$(echo \${${2:json list variable}\} | jq '. | length')
	for (( ${3:i}=0; $3<$1; $3++ )); do
	    ${4:jsonListItem}=\$(echo \$$2 | jq -r ".[\$$3]")
	    $0
	done

snippet jqPutStr jq put a string value into json, key/value can be variables, example : {} -> {'k': '[1,2]'}
	${1:json variable}=\$(echo -n \${$1\} | jq --arg key  "${2:key}"  --arg value  "${3:value}"  '.[\$key]=\$value')
	$0

snippet jqPutJson jq put a json value into json, key/value can be variables, example : {} -> {'k': [1,2]}
	${1:json variable}=\$(echo -n \${$1\} | jq --arg key "${2:key}" --argjson value "${3:value}" '.[\$key]=\$value')
	$0

snippet jqDel jq delete a key, key can be a variable : {'k': 'v', 'k1': 'v1'} -> {'k': 'v'}
	${1:json variable}=\$(echo -n \${$1\} | jq --arg key "${2:key}" 'del(.[\$key])')
	$0

snippet jqKeys get all keys of a json
	${2:var, returned as json:["k"]}=\$(echo -n \$${1:json_var} | jq 'keys')
	$0

snippet jqArrAdd jq assign a value at an array index : [1] -> [1,2], key/value/index can be variables; if the appended element is a string change the flag before value --argjson -> --arg
	${1:json}=$(echo -n "\$$1" | jq --arg key "${2:key}" --argjson index "${3:index}" --argjson value "${4:value}" '.[\$key][\$index]=\$value')
	$0

snippet jqArrAddLength jq append an element to the end of an array : [1] -> [1,2], value can be a variable; if the appended element is a string change the flag before value --argjson -> --arg
	${1:json}=$(echo -n "\$$1" | jq --arg key "${2:key}" --argjson value "${3:value}" '.[\$key][.[\$key] | length]=\$value')
	$0

snippet jqArrDel jq delete an array element (by index), key/index can be variables : echo '[1,2]' | jq 'del(.[0])' -> [2]
	${1:json variable}=\$(echo -n \${$1\} | jq --arg key "${2:key}" --argjson index "${3:index}" 'del(.[\$key][\$index])')
	$0

snippet jqArrDelLength jq delete the last element of an array, key can be a variable : echo '[1,2]' | jq 'del(.[length])' -> [1]
	${1:json variable}=\$(echo -n \${$1\} | jq --arg key "${2:key}" 'del(.[\$key][.[$key] | length - 1])')
	$0
