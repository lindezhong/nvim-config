# #curl
snippet curlGet curl get
	curl -X GET '${1:url}' \
	  -H 'Accept: application/json, text/plain, */*' \
	  -H 'Connection: keep-alive'

snippet curlPost curl post
	curl -X POST '${1:url}' \
	  -H 'Accept: application/json'  \
	  -H 'Content-Type: application/json'  \
	  -H 'Connection: keep-alive'  \
	  --data-raw '${2:json data}'

snippet curlUploadFile curl upload file
	curl '${1:url}' \
	  -H 'Content-Type: multipart/form-data'  \
	  -H 'Connection: keep-alive'  \
	  -F 'file=@${2:filePath}' \
	  -F '${3:key is a plain parameter, value without @}=${4:value}'

snippet curlHeadCookie add cookie
	-H "Cookie: $cookie" \

snippet curlHeadLanguage curl language
	-H 'Accept-Language: zh-CN,zh;'  \

snippet curlUrlencode Use curl to encode a url into a requestable url, keeping only the parameter part; to keep the host part (a host is needed as url_effective) remove the cut command, e.g. key=? -> key=%3f or ? -> %3f
	${3:params}=''$(curl -s -o /dev/null -w '%{url_effective}' --get --data-urlencode "${1:key=value}" "${2:http://example.com}" | cut -d '?' -f2-)''
	$0

snippet urlencode Use curl to encode a url into a requestable url, keeping only the parameter part; to keep the host part (a host is needed as url_effective) remove the cut command, e.g. key=? -> key=%3f or ? -> %3f
	${3:params}=''$(curl -s -o /dev/null -w '%{url_effective}' --get --data-urlencode "${1:key=value}" "${2:http://example.com}" | cut -d '?' -f2-)''
	$0
