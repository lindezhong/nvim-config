# #Variables
# ##Arrays#Variables
# #	count-related, $#: number of shell arguments
# @, *	all elements, $@ $: list of all shell arguments, array[@]/array[]: all elements of the array
# ${#array[@]}	get the number of array elements
# ${#array[*]}	get the number of array elements
# ${array[*]}	get all array elements
# ${array[@]}	get all array elements
# ${!array[@]}	get the array indices
# ${array[@]:n:m}	take m elements starting at position n
# array_new=(${array1[@]} ${array2[@]})	merge arrays: merge array1 and array2 and assign to
# array_new
# array=($(echo ${ayyary[@]} | sed 's/ /\n/g' |sort )) | uniq	deduplicate and sort an array, see
# the detailed explanation
# if echo “${array[@]}” | grep -w “item_1” &>/dev/null; then
# echo "Found"
# fi	check whether item_1 is in array
# #Script arguments
# All script arguments are available via $* and $@ 
# ##Passing variables#Script arguments
# Unquoted they behave the same, but quoted they behave differently
# ```shell
# fun() {
# }
# # Assume the script is test.sh, called as: test.sh "a b" c
# fun $*   # equivalent to calling: fun a b c 
# fun $@   # equivalent to calling: fun a b c 
# fun "$*" # equivalent to calling: fun "a b c" 
# fun "$@" # equivalent to calling: fun "a b" "c" 
# ##Looping over arguments#Script arguments
# ```shell
# #!/bin/bash
# 
# fun() {
#     #prints: 1' '2' '3'
#     for arg in $*; do
#         echo -n "'$arg' " 
#     done
#     echo ""
# 
#     #prints: 1' '2' '3'
#     for arg in $@; do
#         echo -n "'$arg' " 
#     done
#     echo ""
# 
#     #prints: 1 2 3'
#     for arg in "$*"; do
#         echo -n "'$arg' " 
#     done
#     echo ""
# 
#     #prints: 1 2' '3'
#     for arg in "$@"; do
#         echo -n "'$arg' " 
#     done
#     echo ""
# }
# 
# fun "1 2" 3
# ```

snippet arrLength get array length
	${2:length}=\${#${1:array name}[@]\}

snippet arrIn check whether an element is in an array
	if [[ "\${${1:arr}[@]\}" =~ "\${${2:item}\}" ]]; then
	    $0
	fi

snippet arrAdd append an element to the end of an array, e.g. (1 2) -> (1 2 3)
	${1:arr}[${#$1[@]}]=${2:value}

snippet arrPop get and remove the last element of an array, e.g. (1 2 3) -> (1 2)
	${1:element}=\${${2:arr}[${#$2[@]}-1]\}
	unset $2[${#$2[@]}-1]
	$0

snippet arrDel delete an array element by index, e.g. (0 1 2) -> (0 null 2). Note: this makes the array length 2, but only arr[0] and arr[2] exist; arr[1] is gone (leaving a gap), which can break index-based for loops; use mapFor instead
	unset ${1:arr}[${2:index}]

# #!/bin/bash
# fun() {
#     local __tmp_arr_var=$(declare -p "$1")
#     eval "declare -A local arr_var"=${__tmp_arr_var#*=}
#     for arr_item in "${arr_var[@]}"; do
#         echo -n "$arr_item "
#     done
# }
# arr=('1' 2 3)
# fun arr
# output: 3 2 1
snippet arrArgs array as a function/method argument, call example (fun is the function, arr_var the array variable, passed without $). fun arr_var
	local __tmp_arr_var=\$(declare -p "\$${1:index}")
	eval "declare -A local ${2:arr_var}"=${__tmp_arr_var#*=}
	$0

# ##map#Variables
# #	count-related, $#: number of shell arguments
# @, *	all elements, $@ $: list of all shell arguments, array[@]/array[]: all elements of the array
# ${#array[@]}	get the number of array elements
# ${#array[*]}	get the number of array elements
# ${array[*]}	get all array elements
# ${array[@]}	get all array elements
# ${!array[@]}	get the array indices
# ${array[@]:n:m}	take m elements starting at position n
# array_new=(${array1[@]} ${array2[@]})	merge arrays: merge array1 and array2 and assign to
# array_new
# array=($(echo ${ayyary[@]} | sed 's/ /\n/g' |sort )) | uniq	deduplicate and sort an array, see
# the detailed explanation
# if echo “${array[@]}” | grep -w “item_1” &>/dev/null; then
# echo "Found"
# fi	check whether item_1 is in array

snippet mapLength get map length
	${2:length}=\${#${1:map name}[@]\}

snippet mapInKey check whether a map contains a key
	if [ -n "\${${1:map}[${2:key}]\}" ]; then
	    $0
	fi

snippet mapInValue check whether a map contains a Value
	if [[ "\${${1:map}[@]\}" =~ "\${${2:value}\}" ]]; then
	    $0
	fi

snippet mapInit initialize a map; a map defined the normal way cannot be iterated: declare -A map=(['k1']='v1' ['k2']='v2')
	declare -A ${1:map_name}=(${2:initial values})
	$0

snippet mapFor iterate over a map
	for ${2:key} in \${!${1:map_var_name}[@]\}; do
	    ${3:value}=\${$1[\$$2]\}
	    $0
	done

snippet mapForKeys iterate over map keys
	for ${2:key} in \${!${1:map_var_name}[@]\}; do
	    $0
	done

snippet mapForValues iterate over map values
	for ${2:value} in \${${1:map_var_name}[@]\}; do
	    $0
	done

snippet mapPut put data into a map
	${1:map}[${2:key}]=${3:value}

snippet mapDel delete a key from a map
	unset ${1:map}[${2:key}]

# #!/bin/bash
# fun() {
#     local __tmp_map_var=$(declare -p "$1")
#     eval "declare -A local map_var"=${__tmp_map_var#*=}
#     for key in ${!map_var[@]}; do
#         value=${map_var[$key]}
#         echo "$key : $value"
#     done
# }
# declare -A map=(["k"]="v")
# fun map
# output : k : v
snippet mapArgs map as a function/method argument, call example (fun is the function, map_var the map variable, passed without $). fun map_var
	local __tmp_map_var=\$(declare -p "\$${1:index}")
	eval "declare -A local ${2:map_var}"=${__tmp_map_var#*=}
	$0

# ##String str#Variables
snippet strEquals check whether two strings are equal
	if [[ ${1:variable or literal, supports wildcard *} == ${2:variable or literal, supports wildcard *} ]]; then
	    $0
	fi

snippet strInit initialize a variable
	test -z "\$${1:variable name}" && $1="${2:initial value}"

snippet strNull check whether a string is empty
	if [[ -z \$${1:variable name} ]]; then
	    $0
	fi

snippet strReplaceOne replace in a string, wildcards (*) allowed, replaces only the first match
	${4:var}=\${${1:var}/${2:text to replace}/${3:replacement}\}
	$0

snippet strReplaceAll replace in a string, wildcards (*) allowed, replaces all matches
	${4:var}=\${${1:var}//${2:text to replace}/${3:replacement}\}
	$0

snippet strReplaceSed replace in a string using a regular expression; the trailing '/g' replaces all matches, with just '/' only the first match is replaced
	${4:var}=\$(echo \$${1:var} | sed 's/${2:text to replace}/${3:replacement}/g')
	$0

# #!/bin/bash
# str="1xxxx2,3 4"
# OLD_IFS=${IFS}
# IFS="xxxx"
# arr=($str)
# IFS=${OLD_IFS}
# for(( i=0; i<${#arr[@]}; i++)) do
#     item=${arr[i]}
#     echo "$item"
# done
# echo "arr array length: ${#arr[@]}"
# output:
# 1
# 
# 
# 
# 2,3 4
# arr array length: 5
snippet strSplit split a string (by replacing the separator with IFS); watch out for IFS characters already in the string. '1,2 3' -> ['1','2','3']
	${3:str_arr_var}=(\${${1:str_var}//${2:separator}/\${IFS\}\})
	$0

snippet strSplitIfs split a string (by changing IFS); note 1. the separator must be a single character 2. use an indexed for loop (otherwise IFS characters in the original string will split it). '1,2 3' -> ['1','2 3']
	OLD_IFS=\${IFS\}
	IFS='${1:separator}'
	${3:str_arr_var}=(\$${2:str_var})
	IFS=\${OLD_IFS\}
	$0

# ###Substrings##String str#Variables
# ${string: start :length}   starting at the start-th character from the left of string, take length
# characters to the right.
# ${string: start}           starting at the start-th character from the left of string, take
# everything to the end.
# ${string: 0-start :length} starting at the start-th character from the right of string, take
# length characters to the right.
# ${string: 0-start}         starting at the start-th character from the right of string, take
# everything to the end.
# ${string#*chars}           from the first occurrence of *chars in string, take all characters to
# the right of *chars.
# ${string##*chars}          from the last occurrence of *chars in string, take all characters to
# the right of *chars.
# ${string%*chars}           from the first occurrence of *chars in string, take all characters to
# the left of *chars.
# ${string%%*chars}          from the last occurrence of *chars in string, take all characters to
# the left of *chars.
snippet strSubByIndex substring by index, ${'c.biancheng.net': 2 : 9} -> 'biancheng'
	${4:var}=\${${1:string}: ${2:start position, can be negative} :${3:length, omit to go to the end, negative counts from the end}\}

# Use # to take the characters on the right
snippet strSubRightFirst take the string to the right of the keyword (first match), ${'c.biancheng.net'#*.} -> 'biancheng.net'
	${3:var}=\${${1:string}#*${2:keyword}\}

snippet strSubRightLast take the string to the right of the keyword (last match), ${'c.biancheng.net'##*.} -> 'net'
	${3:var}=\${${1:string}##*${2:keyword}\}

# Use % to take the characters on the left
snippet strSubLeftFirst take the string to the left of the keyword (first match), ${'c.biancheng.net'%*.} -> 'c'
	${3:var}=\${${1:string}%%${2:keyword}*\}

snippet strSubLeftLast take the string to the left of the keyword (last match), ${'c.biancheng.net'%%*.} -> 'c.biancheng'
	${3:var}=\${${1:string}%${2:keyword}*\}

# ##Function arguments args#Variables
# $# 	number of arguments passed to the script
# $* 	all arguments passed to the script as a single string. Quoted as "$*", it outputs all
# arguments as "$1 $2 … $n".
# $$ 	process ID of the running script
# $! 	process ID of the last background process
# $@ 	same as $*, but when quoted each argument is returned in its own quotes. Quoted as "$@", it
# outputs all arguments as "$1" "$2" … "$n".
# $- 	shows the current options used by the shell, same as the set command.
# $? 	shows the exit status of the last command. 0 means no error, any other value means an error.
# #!/bin/bash
# echo "-- \$* demo ---"
# for i in "$*"; do
#     echo $i
# done
# echo "-- \$@ demo ---"
# for i in "$@"; do
#     echo $i
# done
# Running `test.sh 1 2 3` outputs:
# -- $* demo ---
# 1 2 3
# -- $@ demo ---
# 1
# 2
# 3
snippet argsFor iterate over arguments (passed in from outside)
	for ${1:item} in "$@"; do
	    $0
	done

# #!/bin/bash
# fun() {
#     local __tmp_map_var=$(declare -p "$1")
#     eval "declare -A local map_var"=${__tmp_map_var#*=}
#     for key in ${!map_var[@]}; do
#         value=${map_var[$key]}
#         echo "$key : $value"
#     done
# }
# declare -A map=(["k"]="v")
# fun map
# output : k : v
snippet argsMap map as a function/method argument, call example (fun is the function, map_var the map variable, passed without $). fun map_var
	local __tmp_map_var=\$(declare -p "\$${1:index}")
	eval "declare -A local ${2:map_var}"=${__tmp_map_var#*=}
	$0

# #!/bin/bash
# fun() {
#     local __tmp_arr_var=$(declare -p "$1")
#     eval "declare -A local arr_var"=${__tmp_arr_var#*=}
#     for arr_item in "${arr_var[@]}"; do
#         echo -n "$arr_item "
#     done
# }
# arr=('1' 2 3)
# fun arr
# output: 3 2 1
snippet argsArr array as a function/method argument, call example (fun is the function, arr_var the array variable, passed without $). fun arr_var
	local __tmp_arr_var=\$(declare -p "\$${1:index}")
	eval "declare -A local ${2:arr_var}"=${__tmp_arr_var#*=}
	$0

# ##Variable var#Variables
snippet varInit initialize a variable
	test -z "\$${1:variable name}" && $1="${2:initial value}"

snippet varNull check whether a string is empty
	if [[ -z \$${1:variable name} ]]; then
	    $0
	fi

# Flow control if for err

# ##if#Flow control
# Common operators:
# File/directory tests:
# [ -a FILE ] true if FILE exists.
# [ -b FILE ] true if FILE exists and is a block special file.
# [ -c FILE ] true if FILE exists and is a character special file.
# [ -d FILE ] true if FILE exists and is a directory.
# [ -e FILE ] true if the given file or directory exists.
# [ -f FILE ] true if FILE exists and is a regular file.
# [ -g FILE ] true if FILE exists and has SGID set.
# [ -h FILE ] true if FILE exists and is a symbolic link. (not supported on some old systems)
# [ -k FILE ] true if FILE exists and has the sticky bit set.
# [ -p FILE ] true if FILE exists and is a named pipe.
# [ -r FILE ] true if FILE exists and is readable.
# [ -s FILE ] true if FILE exists and has a size greater than zero.
# [ -u FILE ] true if FILE exists and has the SUID bit set.
# [ -w FILE ] true if FILE exists and is writable. (a directory must be executable for its contents
# to be accessed)
# [ -x FILE ] true if FILE exists and is executable.
# [ -O FILE ] true if FILE exists and is owned by the effective user ID.
# [ -G FILE ] true if FILE exists and its group is the current group. (only checks the default
# group)
# [ -L FILE ] true if FILE exists and is a symbolic link.
# [ -N FILE ] true if FILE exists and has been modified since it was last read.
# [ -S FILE ] true if FILE exists and is a socket.
# [ FILE1 -nt FILE2 ] true if FILE1 is newer than FILE2, or FILE1 exists and FILE2 does not.
# [ FILE1 -ot FILE2 ] true if FILE1 is older than FILE2, or FILE2 exists and FILE1 does not.
# [ FILE1 -ef FILE2 ] true if FILE1 and FILE2 refer to the same device and inode numbers.
# String tests
# [ -z STRING ]    true if the length of STRING is zero, i.e. empty is true
# [ -n STRING ]    true if the length of STRING is non-zero, i.e. non-empty is true
# [ STRING1 ]     true if the string is not empty, similar to -n
# [ STRING1 == STRING2 ]   true if the two strings are equal
# [ STRING1 != STRING2 ]    true if the strings are not equal
# [ STRING1 < STRING2 ]     true if "STRING1" sorts before "STRING2" lexicographically.
# [ STRING1 > STRING2 ]     true if "STRING1" sorts after "STRING2" lexicographically.
# Numeric tests
# [ INT1 -eq INT2 ]          true if INT1 equals INT2 ,=
# [ INT1 -ne INT2 ]          true if INT1 does not equal INT2 ,<>
# [ INT1 -gt INT2 ]           true if INT1 is greater than INT2 ,>
# [ INT1 -ge INT2 ]          true if INT1 is greater than or equal to INT2,>=
# [ INT1 -lt INT2 ]            true if INT1 is less than INT2 ,<
# [ INT1 -le INT2 ]           true if INT1 is less than or equal to INT2,<=
# Logical tests
# [ ! EXPR ]       logical NOT, true if EXPR is false.
# [ EXPR1 -a EXPR2 ]      logical AND, true if both EXPR1 and EXPR2 are true.
# [ EXPR1 -o EXPR2 ]      logical OR, true if either EXPR1 or EXPR2 is true.
# [  ] || [  ]           combine two conditions with OR
# [  ] && [  ]        combine two conditions with AND
# Other tests
# [ -t FD ]  true if file descriptor FD (default 1) is open and refers to a terminal
# [ -o optionname ]  true if shell option optionname is enabled
# Advanced IF features:
# Double parentheses ((  )): arithmetic expressions
#     The test command only allows simple arithmetic in comparisons; double parentheses support more
#     math operators, and '>' and '<' don't need escaping inside them.
# Double brackets [[  ]]: advanced string handling
#     Tests in double brackets use standard string comparison and also support pattern matching, so
#     you can define regular expressions to match strings.
# What double brackets solve:
# In shell, [ $a != 1 || $b = 2 ] is not allowed; you have to write [ $a != 1 ] || [ $b = 2 ].
# Double brackets solve this: [[ $a != 1 || $b = 2 ]]. Likewise [ "$a" -lt "$b" ] can be written
# with double parentheses as (("$a" < "$b"))

snippet ifStrEquals check whether two strings are equal
	if [[ "${1:variable or literal, supports wildcard *; when using * it must not be in double quotes}" == "${2:variable or literal, supports wildcard *; when using * it must not be in double quotes}" ]]; then
	    $0
	fi

snippet ifStrEqualsRegular check whether two strings are equal, supports regex matching, implemented with grep
	if \`grep -E '${2:regex to match}' <<< "${1:variable or string to compare}" > /dev/null\`; then
	    $0
	fi

snippet ifStrNull check whether a string is empty
	if [[ -z \$${1:variable name} ]]; then
	    $0
	fi

snippet ifVarNull check whether a string is empty
	if [[ -z \$${1:variable name} ]]; then
	    $0
	fi

snippet ifDirExist check whether a directory exists (the directory must not be wrapped in ''); add ! to check that it does not exist
	if [ -d "${1:directory path}" ]; then
	    $0
	fi

snippet ifFileExist check whether a file exists (the file must not be wrapped in ''); add ! to check that it does not exist
	if [ -f "${1:file path}" ]; then
	    $0
	fi

snippet ifNum check whether it is a number; enters the if when it is a number
	if grep -E '^[0-9][0-9]*$' <<< "\$${1:var}" >> /dev/null; then
	    $0
	fi

snippet ifArrIn check whether an element is in an array; enters the if when it is
	if [[ "\${${1:arr}[@]\}" =~ "\${${2:item}\}" ]]; then
	    $0
	fi

snippet ifInArr check whether an element is in an array; enters the if when it is
	if [[ "\${${1:arr}[@]\}" =~ "\${${2:item}\}" ]]; then
	    $0
	fi

snippet ifInMapKey check whether a map contains a key
	if [ -n "\${${1:map}[${2:key}]\}" ]; then
	    $0
	fi

snippet ifInMapValue check whether a map contains a Value
	if [[ "\${${1:map}[@]\}" =~ "\${${2:value}\}" ]]; then
	    $0
	fi

# ##for#Flow control
snippet forArgs iterate over arguments (passed in from outside)
	for ${1:item} in "$@"; do
	    $0
	done

snippet forin iterate over an array without index
	for ${2:item variable name} in "\${${1:array variable name}[@]\}"; do
	    $0
	done

snippet fori iterate over an array with index
	for(( ${1:i}=0; $1<\${#${2:array name}[@]\}; $1++)) do
	    $0\${$2[$1]\}
	done

snippet forStr iterate over a string, each element is a char, 'hello' -> ['h','e','l','l','o']
	for (( ${2:i}=0; $2<=\${#${1:str}\}; $2++ )); do
	    ${3:char}=\${$1:\$$2:1\}
		$0
	done

snippet forMap iterate over a map
	for ${2:key} in \${!${1:map_var_name}[@]\}; do
	    ${3:value}=\${$1[\$$2]\}
	    $0
	done

snippet forMapKeys iterate over map keys
	for ${2:key} in \${!${1:map_var_name}[@]\}; do
	    $0
	done

snippet forMapValues iterate over map values
	for ${2:value} in \${${1:map_var_name}[@]\}; do
	    $0
	done

snippet forArr2In iterate over a 2D array without index, arr2=('1 2 3' '4 5 6'); wrap sub-arrays containing spaces in (')
	for ${2:arr_1_var} in "\${${1:arr}[@]\}"; do
	    eval ${3:arr_2_var}=(\$$2) 
	    for ${4:item} in "\${$3[@]\}"; do
	        $0
		done
	done

snippet forArr2I iterate over a 2D array with index, arr2=('1 2 3' '4 5 6'); wrap sub-arrays containing spaces in (')
	for(( ${1:i}=0; $1<\${#${2:array name}[@]\}; $1++)) do
	    eval ${3:tmp_arr_var}=(\${$2[$1]\})
	    for(( ${4:j}=0; $4<\${#$3[@]\}; $4++)) do
	        $0\${$3[$4]\}
	    done
	done

# ##error#Flow control
snippet errExit exit the script if the previous command failed
	if [ ! $? -eq 0 ]; then
	    exit 1
	fi

snippet errReturn return from the function if the previous command failed
	if [ ! $? -eq 0 ]; then
	    return 1
	fi

# #Environment
snippet homePath directory containing the script; if the file is a symlink the real script path is not resolved
	home_path=$(readlink -f $(dirname "\$0"))
	$0

snippet homePathReal directory containing the script; if the file is a symlink the real script path is resolved
	script_path=\$0
	while [ -L $script_path ]; do
	    # if it is a symlink, resolve the real path
	    script_path=$(ls -al $script_path)
	    script_path=${script_path##*->}
	done
	home_path=$(readlink -f $(dirname "$script_path"))

snippet currentPath get the directory of the currently running script
	current_path=$(pwd)
	$0

# ##Changing directory#Environment
# ```shell
# $ pushd /dir1 # push /dir1 onto the directory stack and switch the current directory to /dir1
# $ pushd /dir2
# $ pushd /dir3
# $ pushd /dir4
# $ dirs -v # show the directory stack; the leading number is the index
# 0 /dir1 
# 1 /dir2
# 2 /dir3
# 3 /dir4
# $ pushd +2 # bring the directory at index 2 to the top of the stack, keeping the order
# $ dirs -v
# 0 /dir3
# 1 /dir4
# 2 /dir1
# 3 /dir2
# $ popd # remove the top of the stack
# 0 /dir4
# 1 /dir1
# 2 /dir2
# ```
snippet pushd push a directory path onto the top of the directory stack (history); afterwards you can navigate to any directory in the stack (default is the top)
	pushd ${1:directory}

snippet popd popd removes a directory from the top of the stack, used together with pushd
	popd

snippet dirs dirs shows the directory stack, used together with pushd and popd
	dirs -v

# #Input/Output
# -t : timeout in seconds; on timeout the variable is not set
# -p : prompt message
# skips after 5s
# example : read -t 5 -p "prompt : " var
snippet read read keyboard input, -t {num} sets a timeout in seconds
	read -p "${1:prompt} : " ${2:variable to read into}
	$0

snippet readNum read a positive integer from the keyboard, re-prompt on non-numeric input, -t {num} sets a timeout in seconds 
	read -p "${1:prompt} : " ${2:variable to read into}
	while [ -z \`grep -E '^[0-9][0-9]*$' <<< "\$$2"\` ]; do
	    read -p "${3:please enter a positive integer} : " $2
	done
	$0

snippet readInArrIndex enter an array index to select an element, -t {num} sets a timeout in seconds 
	while [ -z \`grep -E '^[0-9][0-9]*$' <<< "\$$4"\` ] || [ \$$4 -lt 0 ] || [ \$$4 -gt \${#$2[@]\} ]; do
	    for(( ${1:i}=0; $1<\${#${2:array name}[@]\}; $1++)) do
	        if [ -z "\$$4" ] || [ ! -z \`grep -E '^[0-9][0-9]*$' <<< "\$$4"\`  ] || [ ! -z \`grep "\${$4\}" <<< "\${$2[$1]\}"\` ]; then
	            echo "\$$1) \${$2[$1]\}"
	        fi
	    done
	    read -p "${3:prompt} : " ${4:index variable to read into}
	done
	${5:item}=\${$2[\$$4]\}
	echo "${6:input [\$$4] , selected [\$$5]}"
	$0

snippet readInStr enter an element of a string array, string array example : str_arr='y Y n N', input: y, -t {num} sets a timeout in seconds 
	$3=""
	read -p "${1:prompt} , please enter [\${${3:str_arr}\}] :  " ${2:variable to read into}
	while [[ ! "\${$3[@]\}" =~ "\${$2\}" ]] || [ -z "\${$2\}" ]; do
	    read -p "${4:please enter [\$$3]} : " $2
	done
	$0

snippet readNotNull read keyboard input, empty input not allowed, -t {num} sets a timeout in seconds
	read -p "${1:prompt} : " ${2:variable to read into}
	while [ -z \$$2 ]; do
	    read -p "${3:empty input not allowed, please try again} : " $2
	done
	$0

snippet readPipeline read from a pipe one line at a time; IFS is temporarily changed so leading spaces are kept, and the timeout is set to 1 to avoid hanging, e.g. `echo -e 'aa\nbb' | shell.sh` reads two lines, aa and bb, into line
	while IFS= read -t 1 ${1:line}
	do
	    $0
	done

snippet readFile read a file one line at a time; IFS is temporarily changed so leading spaces are kept
	while IFS= read ${2:line}
	do
	    $0
	done  < ${1:file_path}

snippet readFileFd read a file; IFS is temporarily changed so leading spaces are kept; reads one line at a time from file descriptor FD instead of standard input (0). FD must be a number >= 3; the default descriptors are 0: standard input, 1: standard output, 2: standard error
	exec ${2:fd}< ${1:file_path}
	while IFS= read -u$2 ${3:line}
	do
	    $0
	done
	exec $2<&- # close descriptor $2

snippet readCommand read command output; IFS is temporarily changed so leading spaces are kept; reads one line at a time. >() or <() is a syntax called 'process substitution'. It lets you pass a command's output to another command as a file name, enabling complex I/O operations
	while IFS= read ${2:line}
	do
	    $0
	done  < <(${1:command})

snippet readCommandFd read command output; IFS is temporarily changed so leading spaces are kept; reads one line at a time from file descriptor FD instead of standard input (0). FD must be a number >= 3; the default descriptors are 0: standard input, 1: standard output, 2: standard error. >() or <() is a syntax called 'process substitution'. It lets you pass a command's output to another command as a file name, enabling complex I/O operations
	exec ${2:fd}< <(${1:command})
	while IFS= read -u$2 ${3:line}
	do
	    $0
	done
	exec $2<&- # close descriptor $2

# #awk
snippet awk awk with a given separator, printing one of the split values
	awk -v FS="${1:separator}" '{print \$${2:index, starting at 1}}'

# #Other shell commands/shell
snippet continue skip to the next for/while loop iteration
	continue

snippet eval eval: 1. must be at the very start of the command 2. scans the command after eval twice: the first pass substitutes variables, the second executes it. arr_v='1 2',eval arr=($arr_v) => arr=(1 2)
	eval

snippet template_engine template engine implemented with eval; escape special characters in the template file with '\', e.g. \->\\ `->`\` double quote->\double quote
	eval "echo \"$(cat "${1:template file path}")\" > \"${2:output file path}\""
	$0

# #tee
snippet teeDisable disabled. Prints stdout and stderr normally while also redirecting them to files, keeping stdout and stderr separate. This only works when typed as a command, not inside a shell script, otherwise the shell cannot terminate. >() or <() is a syntax called 'process substitution'. It lets you pass a command's output to another command as a file name, enabling complex I/O operations
	${1:command} > >(tee ${2:stdout}) 2> >(tee ${3:stderr} >&2)
	Disabled: this would keep the shell from terminating because tee keeps waiting while reading the file; only use it when calling the script

snippet teeOutput print stdout and stderr normally while also redirecting them to a file
	${1:command} | tee ${2:output}
	$0

snippet teeOutErr print stdout and stderr normally while also redirecting them to files, keeping separate stdout and stderr files. 1. first write stdout and stderr to temporary files 2. use tee to read the temporary stdout and stderr into the desired files 3. tee must run asynchronously with & at the end because it keeps waiting while reading the file 4. finally call sync to make sure all buffered data is written to disk
	tee '$2' < "$2.tmp" &
	tee '$3' < "$3.tmp" >&2 &
	${1:command} > ${2:stdout}.tmp 2> ${3:stderr}.tmp 
	sync
	$0

# #mkfifo
snippet mkfifo mkfifo creates a named pipe (FIFO, First In First Out). Use -m to set the pipe permissions, e.g. `mkfifo -m 644 my_pipe`. On Unix/Linux, a named pipe is a special file that lets two or more processes communicate: one process writes data into the pipe and another reads from it. 1. create a named pipe `mkfifo my_pipe` 2. write data: `echo 'Hello, World!' > my_pipe` 3. read data: in another terminal, use cat or another command to read from the named pipe: `cat < my_pipe`
