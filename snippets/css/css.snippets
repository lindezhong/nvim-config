#  ╚══════════════════════════════════════════════════════════════════════════════╝
#
# ## display: grid (grid layout)
#
# Grid layout is the most powerful 2D layout system in CSS; it handles rows and columns at the same
# time.
#  ┌────────────────────────────────────────┐
#  │  Container                             │
#  │  display: grid;                        │
#  │                                        │
#  │  ┌────┬────┬────┬────┬────┐            │
#  │  │item│item│item│item│item│ ← items    │
#  │  ├────┼────┼────┼────┼────┤            │
#  │  │item│item│item│item│item│            │
#  │  ├────┼────┼────┼────┼────┤            │
#  │  │item│item│item│item│item│            │
#  │  └────┴────┴────┴────┴────┘            │
#  │                                        │
#  │  ←─ columns ─→  ↑ rows ↑               │
#  └────────────────────────────────────────┘
#
#  Container properties
#
#  ┌───────────────────┬─────────────────────────────────────┬─────────────────────────────────────┐
#  │ Property          │ Effect                              │ Common values                       │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-template-    │ Define rows and columns             │ columns: 1fr 2fr 1fr / repeat(3,    │
#  │ columns/rows      │                                     │ 1fr)                                │
#  │                   │                                     │ rows: 100px 200px                   │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-template-    │ Area naming: defines area names     │ "header header header" (defines a   │
#  │ areas             │ used by grid-area                   │ 2-row, 3-column grid)               │
#  │                   │                                     │ "sidebar main ads"     (header      │
#  │                   │                                     │ takes a whole row)                  │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-row-gap      │ Row gap                             │ 10px / 10%                          │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-column-gap   │ Column gap                          │ 10px / 10%                          │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-gap/gap      │ Set row and column gaps to the same │ 10px / 10%                          │
#  │                   │ value                               │                                     │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ justify-items     │ Horizontal alignment                │ start / center / end / stretch      │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ align-items       │ Vertical alignment                  │ start / center / end / stretch      │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ justify-content   │ Whole grid, horizontal              │ center / space-between / start      │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ align-content     │ Whole grid, vertical                │ center / space-between / start      │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-auto-rows    │ Implicit row height                 │ 100px / minmax(100px, 200px)        │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-auto-columns │ Implicit column width               │ 100px / minmax(100px, auto) at      │
#  │                   │                                     │ least 100px                         │
#  ├───────────────────┼─────────────────────────────────────┼─────────────────────────────────────┤
#  │ grid-auto-flow    │ Auto-placement direction            │ row / column / dense                │
#  └───────────────────┴─────────────────────────────────────┴─────────────────────────────────────┘
#
#  Item properties
#  ┌──────────────┬───────────────────────────────────────┬────────────────────────────────────────┐
#  │ Property     │ Effect                                │ Common values                          │
#  ├──────────────┼───────────────────────────────────────┼────────────────────────────────────────┤
#  │ grid-column  │ Column position (start/end column),   │ 1 / 3                                  │
#  │              │ can span columns                      │ span 2 (spans two columns from the     │
#  │              │ (grid-column-start/grid-column-end)   │ current one)                           │
#  │              │                                       │ 1 / span 2 (spans two columns from     │
#  │              │                                       │ column 1)                              │
#  │              │                                       │ 1 (spans 1 column from column 1)       │
#  ├──────────────┼───────────────────────────────────────┼────────────────────────────────────────┤
#  │ grid-row     │ Row position (start/end row), can     │ 1 / 2 , span 2 ,  1 / span 2           │
#  │              │ span rows                             │                                        │
#  ├──────────────┼───────────────────────────────────────┼────────────────────────────────────────┤
#  │ grid-area    │ Area placement                        │ header (name from grid-template-areas) │
#  │              │ row-start/col-start/row-end/col-end   │ 1 / 1 / 3 / 3                          │
#  ├──────────────┼───────────────────────────────────────┼────────────────────────────────────────┤
#  │ justify-self │ Horizontal alignment of itself        │ center / start / end                   │
#  ├──────────────┼───────────────────────────────────────┼────────────────────────────────────────┤
#  │ align-self   │ Vertical alignment of itself          │ center / start / end                   │
#  └──────────────┴───────────────────────────────────────┴────────────────────────────────────────┘
#
#  Units explained
#  ┌───────────┬─────────────────────────────────────────────────────────────────┐
#  │ Unit      │ Description and examples                                        │
#  ├───────────┼─────────────────────────────────────────────────────────────────┤
#  │ fr        │ Fraction unit, divides the remaining space                      │
#  │           │ grid-template-columns: 1fr 2fr 1fr;  →  1:2:1 ratio             │
#  │           │ grid-template-columns: 200px 1fr;      →  fixed + flexible      │
#  ├───────────┼─────────────────────────────────────────────────────────────────┤
#  │ repeat    │ Repeat function                                                 │
#  │           │ repeat(3, 1fr);              →  1fr 1fr 1fr (three equal parts) │
#  │           │ repeat(2, 100px 1fr);        →  100px 1fr 100px 1fr             │
#  ├───────────┼─────────────────────────────────────────────────────────────────┤
#  │ auto-fit  │ Auto-fill, fits the container                                   │
#  │           │ repeat(auto-fit, minmax(200px, 1fr));  →  responsive grid       │
#  ├───────────┼─────────────────────────────────────────────────────────────────┤
#  │ auto-fill │ Auto-fill, may leave empty tracks                               │
#  │           │ repeat(auto-fill, minmax(150px, 1fr)); →  filled grid           │
#  ├───────────┼─────────────────────────────────────────────────────────────────┤
#  │ minmax    │ Minimum/maximum range                                           │
#  │           │ minmax(100px, 1fr);         →  min 100px, max 1fr               │
#  │           │ minmax(200px, auto);        →  min 200px, max fits content      │
#  └───────────┴─────────────────────────────────────────────────────────────────┘
#
#
#   justify-items: horizontal alignment of items within their cells
#
#   start                   center                 end                    stretch (default)
#   ┌──────┐                ┌──────┐               ┌──────┐               ┌──────────────┐
#   │ item │                │ item │               │  item│               │     item     │
#   └──────┘                └──────┘               └──────┘               │              │
#   ↑left                   ↑center                ↑right                 └──────────────┘
#                                                                         ↑ stretched to fill
#
#   Note: the item aligns   Note: the item is      Note: the item aligns  Note: the item stretches
#   to the cell's left edge centered horizontally  to the right cell edge to fill the whole cell
#                           in the cell                                   (if the item width is
#                                                                         not set)
#
#
# align-items: vertical alignment of items within their cells
#
#         start                    center                   end                   stretch (default)
#         ┌──────┐                 ┌──────┐               ┌──────┐                ┌──────┐
#         │ item │                 │      │               │      │                │      │
#         │      │                 │ item │               │      │                │ item │
#         │      │                 │      │               │      │                │      │
#         └──────┘                 └──────┘               │  item│                │      │
#         ↑top                      ↑center               └──────┘                └──────┘
#                                                                                 ↑stretched to fill
#
# Note: the item aligns to    Note: the item is         Note: the item aligns   Note: the item
#       the cell's top edge   centered vertically       to the cell's bottom    stretches to fill
#                             in the cell               edge                    the whole cell (if
#                                                                               the item height is
#                                                                               not set)
#
#  justify-content: horizontal alignment of the whole grid in the container (applies when the grid
#  is narrower than the container)
#
#  start                             center                          end
#  ┌──────────┐                    ┌──────────┐                 ┌──────────┐
#  │1  2      │                    │ 1  2     │                 │     1  2 │
#  │3         │                    │ 3        │                 │      3   │
#  └──────────┘                    └──────────┘                 └──────────┘
#  aligned left                    centered                     aligned right
#
#  space-between                   space-around                 space-evenly
#  ┌────────┐                     ┌────────┐                     ┌────────┐
#  │1      2│                     │ 1    2 │                     │  1  2  │
#  │3       │                     │ 3      │                     │  3     │
#  └────────┘                     └────────┘                     └────────┘
#  no space at the ends,          ends get 1/2 space,            all spaces equal,
#  equal space between            between gets 1 space           including the ends
#
#  align-content: vertical alignment of the whole grid in the container (applies when the grid is
#  shorter than the container)
#
#  start                      center                     end
#  ┌────┐                     ┌────┐                     ┌────┐
#  │1  2│                     │    │                     │    │
#  │3   │                     │1  2│                     │    │
#  │    │                     │3   │                     │1  2│
#  │    │                     │    │                     │3   │
#  └────┘                     └────┘                     └────┘
#  aligned to top             centered                   aligned to bottom
#
#  space-between     align-content: space-around       align-content: space-evenly
#  ┌────┐                         ┌────┐                         ┌────┐
#  │1  2│                         │    │                         │    │
#  │    │                         │1  2│                         │1  2│
#  │    │                         │    │                         │    │
#  │3   │                         │    │                         │3   │
#  └────┘                         │3   │                         │    │
#  		                          │    │                         └────┘   
#  		                          └────┘                         
#  no space at the ends,          ends get 1/2 space,            all spaces equal,
#  equal space between            between gets 1 space           including the ends
#                                                                           
#
#
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                 Total container size: 1400px × 800px                          ║
# ║                 display: grid;                                                ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║  [Root container Grid config]                                                 ║
# ║  ─────────────────────────────────────────────────────────────────────────────║
# ║  grid-template-columns: 200px 1fr 280px;                                      ║
# ║  → column 1: fixed 200px (left sidebar)                                       ║
# ║  → column 2: flexible 1fr (main content, actually 840px)                      ║
# ║  → column 3: fixed 280px (right sidebar)                                      ║
# ║  → column widths: 200 + 20 + 840 + 20 + 280 = 1360px                          ║
# ║  → left/right margin: (1400-1360)÷2 = 20px (justify-content: center)          ║
# ║                                                                               ║
# ║  grid-template-rows: 80px 1fr 100px;                                          ║
# ║  → row 1: fixed 80px (top bar)                                                ║
# ║  → row 2: flexible 1fr (main area, actually 570px)                            ║
# ║  → row 3: fixed 100px (bottom bar)                                            ║
# ║  → row heights: 80 + 20 + 570 + 20 = 690px                                    ║
# ║  → top/bottom margin: (800-690)÷2 = 55px (align-content: center)              ║
# ║                                                                               ║
# ║  grid-template-areas:                                                         ║
# ║    "header header header"     → header spans 3 columns                        ║
# ║    "sidebar main aside"       → 3 areas, 1 column each                        ║
# ║    "footer footer footer"     → footer spans 3 columns                        ║
# ║                                                                               ║
# ║  gap: 20px;                      → 20px row and column gap                    ║
# ║  justify-items: stretch;        → grid items stretch horizontally             ║
# ║  align-items: stretch;          → grid items stretch vertically               ║
# ║  justify-content: center;       → container centered horizontally             ║
# ║  align-content: center;         → container centered vertically               ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║                                                                               ║
# ║  ┌─────────────────────────────────────────────────────────────────────┐      ║
# ║  │  header area                                                        │      ║
# ║  │  [Grid config]                                                      │      ║
# ║  │  grid-area: header;              → equivalent to:                   │      ║
# ║  │     grid-row: 1 / 2;              → row 1                           │      ║
# ║  │     grid-column: 1 / 4;           → spans 3 cols (line 1 to 4)      │      ║
# ║  │     or grid-column: span 3;       → spans 3 cols                    │      ║
# ║  │                                                                     │      ║
# ║  │  width: 1360px (200+20+840+20+280)   height: 80px (fixed)           │      ║
# ║  │                                                                     │      ║
# ║  │  [Nested Grid]                                                      │      ║
# ║  │  display: grid;                                                     │      ║
# ║  │  grid-template-columns: 180px 1fr 200px 180px;                      │      ║
# ║  │  → 4 cols: fixed 180px + flexible + fixed 200px + fixed 180px       │      ║
# ║  │  → column 2 width: 1360-30-180-200-180 = 770px                      │      ║
# ║  │  grid-template-rows: 80px;                                          │      ║
# ║  │  gap: 10px;                                                         │      ║
# ║  │                                                                     │      ║
# ║  │  ┌──────┐  ┌───────────────────┐  ┌──────────┐  ┌──────────┐        │      ║
# ║  │  │ Logo │  │    Title area     │  │  Search  │  │   User   │        │      ║
# ║  │  │180px │  │      770px        │  │  200px   │  │  180px   │        │      ║
# ║  │  │ 80px │  │      80px         │  │  80px    │  │  80px    │        │      ║
# ║  │  │col:1 │  │  col: 2 / 3 (1fr) │  │col: 3/4  │  │col: 4/5  │        │      ║
# ║  │  └──────┘  └───────────────────┘  └──────────┘  └──────────┘        │      ║
# ║  └─────────────────────────────────────────────────────────────────────┘      ║
# ║                                    ↑ gap: 20px ↑                              ║
# ║  ┌────────┐  ┌─────────────────────────────────────────┐  ┌────────────┐      ║
# ║  │        │  │                                         │  │            │      ║
# ║  │side-   │  │                  main                   │  │  aside     │      ║
# ║  │ bar    │  │                                         │  │            │      ║
# ║  │        │  │                                         │  │            │      ║
# ║  │200px   │  │              840px (1fr)                │  │  280px     │      ║
# ║  │570px   │  │              570px (1fr)                │  │  570px     │      ║
# ║  │        │  │                                         │  │            │      ║
# ║  │[config]│  │  [Grid config]                          │  │[config]    │      ║
# ║  │grid-   │  │  grid-area: main;                       │  │grid-area:  │      ║
# ║  │area:   │  │     grid-column: 2 / 3;                 │  │aside;      │      ║
# ║  │side-   │  │     grid-row: 2 / 3;                    │  │grid-col:   │      ║
# ║  │bar     │  │     or span 1                           │  │3 / 4;      │      ║
# ║  │grid-   │  │  width: 840px (flexible 1fr)            │  │grid-row:   │      ║
# ║  │col:    │  │  height: 570px (flexible 1fr)           │  │2 / 3;      │      ║
# ║  │1/2     │  │                                         │  │w: 280px    │      ║
# ║  │grid-   │  │  [Nested Grid]                          │  │h: 570px    │      ║
# ║  │row:    │  │  display: grid;                         │  │            │      ║
# ║  │2/3     │  │  grid-template-columns: repeat(3, 1fr); │  │[nested]    │      ║
# ║  │        │  │  → 3 equal cols, (840-40)/3 = 266px each│  │display:    │      ║
# ║  │[inner] │  │  grid-template-rows: repeat(2, 150px);  │  │grid;       │      ║
# ║  │display │  │  → 2 rows, fixed 150px                  │  │grid-temp   │      ║
# ║  │:grid;  │  │  gap: 20px;                             │  │-late-col:  │      ║
# ║  │grid-   │  │  → 3×2 = 6 cards                        │  │repeat(2,   │      ║
