#
# # Locating CSS styles
# ## Inheritance
#
# Table of which CSS properties are inherited
#  ┌─────────────┬────────────────────────────────┬───────────────────────────────┐
#  │ Category    │ Inheritable                    │ Not inheritable               │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Text        │ color, font-size, font-family, │ -                             │
#  │             │ font-weight, line-height,      │                               │
#  │             │ letter-spacing, word-spacing,  │                               │
#  │             │ text-align, text-decoration,   │                               │
#  │             │ text-transform, text-shadow    │                               │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Font        │ font-style, font-variant       │ -                             │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ List        │ list-style-type,               │ -                             │
#  │             │ list-style-position,           │                               │
#  │             │ list-style-image               │                               │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Table       │ border-collapse, caption-side, │ -                             │
#  │             │ empty-cells, table-layout      │                               │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Box model   │ -                              │ width, height,                │
#  │             │                                │ margin, padding,              │
#  │             │                                │ border,                       │
#  │             │                                │ min/max-width, min/max-height │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Positioning │ -                              │ position, top, right,         │
#  │             │                                │ bottom, left,                 │
#  │             │                                │ z-index, float, clear         │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Background  │ -                              │ background-color,             │
#  │             │                                │ background-image,             │
#  │             │                                │ background-repeat,            │
#  │             │                                │ background-position,          │
#  │             │                                │ background-size               │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Display     │ visibility, cursor             │ display, overflow,            │
#  │             │                                │ vertical-align                │
#  ├─────────────┼────────────────────────────────┼───────────────────────────────┤
#  │ Motion      │ -                              │ transform, transition,        │
#  │             │                                │ animation                     │
#  └─────────────┴────────────────────────────────┴───────────────────────────────┘
# 
# ### Special values that control inheritance
#  ┌──────────────┬──────────────────────────────────────────────────┬─────────────────────────────┐
#  │ Value        │ Effect                                           │ In short                    │
#  ├──────────────┼──────────────────────────────────────────────────┼─────────────────────────────┤
#  │ inherit      │ Inherit the parent's property value              │ Same as the parent          │
#  ├──────────────┼──────────────────────────────────────────────────┼─────────────────────────────┤
#  │ initial      │ Reset to the initial value from the CSS spec     │ Use the CSS default         │
#  ├──────────────┼──────────────────────────────────────────────────┼─────────────────────────────┤
#  │ revert       │ Reset to the browser's default style             │ Use the browser default     │
#  ├──────────────┼──────────────────────────────────────────────────┼─────────────────────────────┤
#  │ revert-layer │ Reset to the value from the previous cascade     │ Use the previous layer      │
#  │              │ layer                                            │                             │
#  ├──────────────┼──────────────────────────────────────────────────┼─────────────────────────────┤
#  │ unset        │ inherit if inheritable, otherwise initial        │ Handled naturally (default) │
#  └──────────────┴──────────────────────────────────────────────────┴─────────────────────────────┘
#
# Typical use cases
#  ┌──────────────────────────────────┬──────────────┬─────────────────────────────────────────────┐
#  │ Scenario                         │ Value used   │ Code example                                │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Link inherits the parent's color │ inherit      │ a { color: inherit; text-decoration:        │
#  │                                  │              │ inherit; }                                  │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Reset button styles              │ initial      │ button { all: initial; }                    │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Restore default heading margins  │ revert       │ h1 { margin: revert; }                      │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Simple bulk reset                │ unset        │ * { margin: unset; padding: unset; }        │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Force border inheritance         │ inherit      │ .child { border: inherit; }                 │
#  ├──────────────────────────────────┼──────────────┼─────────────────────────────────────────────┤
#  │ Cascade layer fallback           │ revert-layer │ @layer override { .el { color:              │
#  │                                  │              │ revert-layer; }}                            │
#
#
# ## CSS selectors
#  ┌─────────────────┬──────────────────┬───────────────────┬───────────────────┬──────────────────┐
#  │ Category        │ Selector type    │ Syntax            │ Example           │ Description      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Basic selectors │ Element selector │ element           │ div               │ Selects all      │
#  │                 │                  │                   │                   │ elements of the  │
#  │                 │                  │                   │                   │ given type       │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Basic selectors │ Class selector   │ .class            │ .container        │ Selects all      │
#  │                 │                  │                   │                   │ elements with    │
#  │                 │                  │                   │                   │ the given class  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Basic selectors │ ID selector      │ #id               │ #header           │ Selects the      │
#  │                 │                  │                   │                   │ element with the │
#  │                 │                  │                   │                   │ given ID         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Basic selectors │ Universal        │ *                 │ *                 │ Selects all      │
#  │                 │ selector         │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Basic selectors │ Grouping         │ selector1,        │ h1, h2            │ Selects elements │
#  │                 │ selector         │ selector2         │                   │ matching any of  │
#  │                 │                  │                   │                   │ the selectors    │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Combinators     │ Descendant       │ ancestor          │ div p             │ Selects all      │
#  │                 │ selector         │ descendant        │                   │ descendants      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Combinators     │ Child selector   │ parent > child    │ ul > li           │ Selects direct   │
#  │                 │                  │                   │                   │ children         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Combinators     │ Adjacent sibling │ element + sibling │ h1 + p            │ Selects the      │
#  │                 │ selector         │                   │                   │ immediately      │
#  │                 │                  │                   │                   │ following        │
#  │                 │                  │                   │                   │ sibling          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Combinators     │ General sibling  │ element ~ sibling │ h1 ~ p            │ Selects all      │
#  │                 │ selector         │                   │                   │ following        │
#  │                 │                  │                   │                   │ siblings         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Attribute        │ [attr]            │ [data-id]         │ Selects elements │
#  │ selectors       │ present          │                   │                   │ with the given   │
#  │                 │                  │                   │                   │ attribute        │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Attribute        │ element[attr]     │ a[data-id]        │ Attribute        │
#  │ selectors       │ present          │                   │                   │ selectors can be │
#  │                 │                  │                   │                   │ combined with    │
#  │                 │                  │                   │                   │ element          │
#  │                 │                  │                   │                   │ selectors        │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Exact match      │ [attr="value"]    │ [type="text"]     │ Attribute value  │
#  │ selectors       │                  │                   │                   │ matches exactly  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Word match       │ [attr~="value"]   │ [class~="active"] │ Attribute value  │
#  │ selectors       │                  │                   │                   │ contains the     │
#  │                 │                  │                   │                   │ given word       │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Prefix match     │ [attr^="value"]   │ [href^="https"]   │ Attribute value  │
#  │ selectors       │                  │                   │                   │ starts with the  │
#  │                 │                  │                   │                   │ given value      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Suffix match     │ [attr$="value"]   │ [src$=".jpg"]     │ Attribute value  │
#  │ selectors       │                  │                   │                   │ ends with the    │
#  │                 │                  │                   │                   │ given value      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Substring match  │ [attr*="value"]   │ [href*="google"]  │ Attribute value  │
#  │ selectors       │                  │                   │                   │ contains the     │
#  │                 │                  │                   │                   │ given string     │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Attribute       │ Hyphen prefix    │ [attr|="value"]   │ [lang|="zh"]      │ Attribute value  │
#  │ selectors       │                  │                   │                   │ starts with      │
#  │                 │                  │                   │                   │ value-           │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Link            │ Unvisited link   │ :link             │ a:link            │ Links not yet    │
#  │ pseudo-classes  │                  │                   │                   │ visited          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Link            │ Visited link     │ :visited          │ a:visited         │ Links already    │
#  │ pseudo-classes  │                  │                   │                   │ visited          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Link            │ Focus state      │ :focus            │ input:focus       │ When it has      │
#  │ pseudo-classes  │                  │                   │                   │ focus            │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Link            │ Mouse hover      │ :hover            │ button:hover      │ When the mouse   │
#  │ pseudo-classes  │                  │                   │                   │ hovers over it   │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Link            │ Active state     │ :active           │ button:active     │ When it is       │
#  │ pseudo-classes  │                  │                   │                   │ activated        │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ First child      │ :first-child      │ li:first-child    │ The first child  │
#  │ pseudo-classes  │                  │                   │                   │                  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Last child       │ :last-child       │ li:last-child     │ The last child   │
#  │ pseudo-classes  │                  │                   │                   │                  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ n-th child       │ :nth-child(n)     │ li:nth-child(2)   │ The n-th child   │
#  │ pseudo-classes  │                  │                   │                   │                  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Odd/even         │ :nth-child(odd/   │ li:nth-child(odd) │ odd: odd items,  │
#  │ pseudo-classes  │ children         │ even)             │                   │ even: even items │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ n-th from the    │ :nth-last-child(  │ li:nth-last-      │ The n-th child   │
#  │ pseudo-classes  │ end              │ n)                │ child(2)          │ from the end     │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Only child       │ :only-child       │ p:only-child      │ The only child   │
#  │ pseudo-classes  │                  │                   │                   │                  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ First of type    │ :first-of-type    │ p:first-of-type   │ The first of its │
#  │ pseudo-classes  │                  │                   │                   │ type             │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Last of type     │ :last-of-type     │ p:last-of-type    │ The last of its  │
#  │ pseudo-classes  │                  │                   │                   │ type             │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ n-th of type     │ :nth-of-type(n)   │ p:nth-of-type(2)  │ The n-th of its  │
#  │ pseudo-classes  │                  │                   │                   │ type             │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ n-th of type     │ :nth-last-of-     │ p:nth-last-of-    │ The n-th of its  │
#  │ pseudo-classes  │ from the end     │ type(n)           │ type(2)           │ type from the    │
#  │                 │                  │                   │                   │ end              │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Only of type     │ :only-of-type     │ img:only-of-type  │ The only element │
#  │ pseudo-classes  │                  │                   │                   │ of its type      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Root element     │ :root             │ :root             │ The root element │
#  │ pseudo-classes  │                  │                   │                   │ of the document  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Empty element    │ :empty            │ div:empty         │ Elements with no │
#  │ pseudo-classes  │                  │                   │                   │ children         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Structural      │ Target element   │ :target           │ section:target    │ The anchor       │
#  │ pseudo-classes  │                  │                   │                   │ target element   │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Enabled state    │ :enabled          │ input:enabled     │ Enabled form     │
#  │ pseudo-classes  │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Disabled state   │ :disabled         │ input:disabled    │ Disabled form    │
#  │ pseudo-classes  │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Checked state    │ :checked          │ input:checked     │ Checked          │
#  │ pseudo-classes  │                  │                   │                   │ checkboxes/radio │
#  │                 │                  │                   │                   │ buttons          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Required field   │ :required         │ input:required    │ Required form    │
#  │ pseudo-classes  │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Optional field   │ :optional         │ input:optional    │ Optional form    │
#  │ pseudo-classes  │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Valid            │ :valid            │ input:valid       │ Elements that    │
#  │ pseudo-classes  │                  │                   │                   │ pass validation  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Invalid          │ :invalid          │ input:invalid     │ Elements that    │
#  │ pseudo-classes  │                  │                   │                   │ fail validation  │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ In range         │ :in-range         │ input:in-range    │ Value is within  │
#  │ pseudo-classes  │                  │                   │                   │ range            │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Out of range     │ :out-of-range     │ input:out-of-     │ Value is out of  │
#  │ pseudo-classes  │                  │                   │ range             │ range            │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Read-only state  │ :read-only        │ input:read-only   │ Read-only        │
#  │ pseudo-classes  │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Form            │ Read-write state │ :read-write       │ input:read-write  │ Readable and     │
#  │ pseudo-classes  │                  │                   │                   │ writable         │
#  │                 │                  │                   │                   │ elements         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Logical         │ Negation         │ :not(selector)    │ :not(.active)     │ Does not match   │
#  │ pseudo-classes  │ selector         │                   │                   │ the given        │
#  │                 │                  │                   │                   │ selector         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Logical         │ Parent selector  │ :has(selector)    │ div:has(p)        │ Contains the     │
#  │ pseudo-classes  │                  │                   │                   │ given child      │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Specificity     │ Matches-any      │ :is(selector)     │ :is(.active)      │ Specificity =    │
#  │ pseudo-classes  │ pseudo-class     │                   │                   │ the highest      │
#  │                 │                  │                   │                   │ specificity (of  │
#  │                 │                  │                   │                   │ the selectors)   │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Specificity     │ Zero-specificity │ :where(selector)  │ :where(#active)   │ Specificity = 0  │
#  │ pseudo-classes  │ pseudo-class     │                   │                   │ (of the          │
#  │                 │                  │                   │                   │ selectors)       │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ First letter     │ ::first-letter    │ p::first-letter   │ The first letter │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ First line       │ ::first-line      │ p::first-line     │ The first line   │
#  │                 │                  │                   │                   │ of text          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ Insert before    │ ::before          │ p::before         │ Inserts content  │
#  │                 │                  │                   │                   │ before the       │
#  │                 │                  │                   │                   │ element          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ Insert after     │ ::after           │ p::after          │ Inserts content  │
#  │                 │                  │                   │                   │ after the        │
#  │                 │                  │                   │                   │ element          │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ Selected text    │ ::selection       │ p::selection      │ Text selected by │
#  │                 │                  │                   │                   │ the user         │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ Pseudo-elements │ Placeholder      │ ::placeholder     │ input::           │ Form placeholder │
#  │                 │                  │                   │ placeholder       │ text             │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ New in CSS3     │ Focus within     │ :focus-within     │ form:focus-within │ A child element  │
#  │                 │                  │                   │                   │ has focus        │
#  ├─────────────────┼──────────────────┼───────────────────┼───────────────────┼──────────────────┤
#  │ New in CSS3     │ Focus visible    │ :focus-visible    │ button:focus-     │ Explicitly       │
#  │                 │                  │                   │ visible           │ focused          │
#  └─────────────────┴──────────────────┴───────────────────┴───────────────────┴──────────────────┘
#
# ## Specificity and the cascade
# 
# ### Specificity table
# ┌────────────────────────┬─────────────────┬──────────────────────┬─────────────┬────────────────┐
# │ Specificity format     │ Example         │ Selector type        │ Cascade     │ Value          │
# │                        │                 │                      │ order       │                │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ !important(∞)          │ color: red      │ !important           │ Highest     │ ∞              │
# │                        │ !important;     │                      │ priority    │                │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Inline style(1000)     │ <p style="">    │ Inline style         │ Priority 2  │ 1000           │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ ID(100)                │ #header         │ Single ID            │ Priority 3  │ 100            │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ ID+class(110)          │ #nav .active    │ ID+class             │ Priority 3  │ 110            │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+ID(101)            │ div#header      │ Tag+ID               │ Priority 3  │ 101            │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ ID+tag+class(111)      │ #nav a.link     │ ID+tag+class         │ Priority 3  │ 111            │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ ID+ID(200)             │ #header#nav     │ ID+ID                │ Priority 3  │ 200            │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Class(10)              │ .class          │ Single class         │ Priority 4  │ 10             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Attribute(10)          │ [type="text"]   │ Attribute selector   │ Priority 4  │ 10             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Pseudo-class(10)       │ :hover          │ Single pseudo-class  │ Priority 4  │ 10             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Class+class(20)        │ .btn.active     │ Class+class          │ Priority 4  │ 20             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Class+pseudo-class(20) │ .btn:hover      │ Class+pseudo-class   │ Priority 4  │ 20             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+class(11)          │ div.class       │ Tag+class            │ Priority 4  │ 11             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+pseudo-class(11)   │ a:hover         │ Tag+pseudo-class     │ Priority 4  │ 11             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+attribute(11)      │ a[data-id]      │ Tag+attribute        │ Priority 4  │ 11             │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Element(1)             │ div             │ Single tag           │ Priority 5  │ 1              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+tag(2)             │ div p           │ Descendant selector  │ Priority 5  │ 2              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+tag(2)             │ ul > li         │ Child selector       │ Priority 5  │ 2              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+tag(2)             │ h1 + p          │ Adjacent sibling     │ Priority 5  │ 2              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+tag(2)             │ h1 ~ p          │ General sibling      │ Priority 5  │ 2              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Tag+pseudo-element(2)  │ p::before       │ Tag+pseudo-element   │ Priority 5  │ 2              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Pseudo-element(1)      │ ::before        │ Single               │ Priority 5  │ 1              │
# │                        │                 │ pseudo-element       │             │                │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Universal(0)           │ *               │ Universal selector   │ Priority 6  │ 0              │
# ├────────────────────────┼─────────────────┼──────────────────────┼─────────────┼────────────────┤
# │ Inherited              │ -               │ Inherited style      │ Priority 7  │ No specificity │
# └────────────────────────┴─────────────────┴──────────────────────┴─────────────┴────────────────┘
#
# ### Cascade layers
# ┌─────────────────┬───────────────────┬────────────────────────────┬─────────────────────────────┐
# │ Category        │ Topic             │ Details                    │ Example code                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @import         │ Definition        │ Imports an external CSS    │ @import url('style.css')    │
# │                 │                   │ file into the current      │                             │
# │                 │                   │ stylesheet                 │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Purpose           │ Modular CSS, split styles  │ Split a large file into     │
# │                 │                   │ into separate files        │ several small ones          │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Position          │ Must come before all CSS   │ @import first; body{} after │
# │                 │                   │ rules (except @charset)    │ ✓                           │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Syntax            │ url() / '' / with media    │ @import 'print.css' print   │
# │                 │                   │ query / with condition     │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Layer support     │ Can be imported into a     │ @import url() layer(name)   │
# │                 │                   │ given layer                │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Performance       │ Blocks rendering; prefer   │ Not recommended in large    │
# │                 │                   │ <link>                     │ numbers                     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @media basics   │ Definition        │ Media query: applies       │ @media (min-width:768px){}  │
# │                 │                   │ different styles by device │                             │
# │                 │                   │ characteristics            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Purpose           │ Responsive design for      │ Different styles for        │
# │                 │                   │ different devices          │ phone/tablet/desktop        │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Position          │ Anywhere in the CSS        │ Inside or outside a         │
# │                 │                   │                            │ stylesheet                  │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Syntax            │ min/max-width /            │ @media (orientation:        │
# │                 │                   │ orientation /              │ portrait) {}                │
# │                 │                   │ prefers-color-scheme /     │                             │
# │                 │                   │ print                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Logical           │ and / or / not / only      │ @media (min-w:768px) and    │
# │                 │ operators         │                            │ (max-w:1024px)              │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Common            │ mobile<768px / tablet      │ @media (max-width:767px)    │
# │                 │ breakpoints       │ 768-1024px /               │ @media (min-w:768px) and    │
# │                 │                   │ desktop>1024px             │ (max-w:1024px)              │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @import and     │ Import into       │ Imports an external CSS    │ @import url('reset.css')    │
# │ @layer          │ a layer           │ file into a given layer    │ layer(reset)                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Anonymous layer   │ Creates an anonymous layer │ @import url('a.css') layer  │
# │                 │                   │ when no name is given      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Multiple layers   │ Import different files     │ @import url('a.css')        │
# │                 │                   │ into different layers      │ layer(a); @import url('b')  │
# │                 │                   │                            │ layer(b)                    │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Full example      │ Use at the top of the main │ @import url('reset.css')    │
# │                 │                   │ stylesheet                 │ layer(reset); @import url   │
# │                 │                   │                            │ ('base.css') layer(base)    │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Note              │ ⚠️ @import must come       │ │ ✓ @import first; ✗        │
# │                 │                   │ before all CSS rules       │ @import after               │
# │                 │                   │                            │ (invalid)                   │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @media and      │ Form A            │ Media query outside: the   │ @media (min-w:768px) {      │
# │ @layer          │                   │ whole layer only exists    │ @layer responsive {...}}    │
# │                 │                   │ while the media query      │                             │
# │                 │                   │ matches                    │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Form B            │ Layer outside: the media   │ @layer responsive { @mediaa │
# │                 │                   │ query is just part of the  │ (min-w:768px) {...}}        │
# │                 │                   │ layer                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Form C            │ Declare first, then        │ @layer res; @media {...} {  │
# │                 │                   │ combine                    │ @layer res {...}}           │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Form D            │ Several layers share one   │ @media {...} { @layer a {}} │
# │                 │                   │ media query                │ @layer b {}}                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Form E            │ Anonymous layer + media    │ @media {...} { @layer {.}}  │
# │                 │                   │ query                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Recommended       │ Prefer form A              │ Clearer; the layer is fully │
# │                 │                   │                            │ controlled by the media     │
# │                 │                   │                            │ query                       │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @layer basics   │ Full name         │ CSS Cascading Layers       │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Version           │ CSS Cascading and          │                             │
# │                 │                   │ Inheritance L5             │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Purpose           │ Controls style priority    │                             │
# │                 │                   │ layers, resolves style     │                             │
# │                 │                   │ conflicts                  │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Browsers          │ Chrome99+ / Firefox97+ /   │                             │
# │                 │                   │ Safari15.4+                │                             │
# │                 │                   │ / Edge99+                  │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @layer syntax   │ Declare one       │ @layer name;               │ @layer base;                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Declare many      │ @layer a,b,c;              │ @layer reset,base,comp;     │
# │                 │                   │ comma-separated            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Declare and       │ @layer name{rules}         │ @layer base{body{font:16px  │
# │                 │ define            │                            │ }}                          │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Anonymous layer   │ @layer{rules} without a    │ @layer{color:red;}          │
# │                 │                   │ name                       │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Nested layer      │ @layer outer{@layer        │ @layer framework.theme {}   │
# │                 │                   │ inner;}                    │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ @import+        │ Combined          │ Import responsive styles   │ @import url('mobile.css')   │
# │ @media          │ use               │                            │ layer(base); @media ...     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Layer priority  │ Between layers    │ Later-defined layer >      │ @layer a,b; → b overrides a │
# │                 │                   │ earlier-defined layer      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Unlayered vs      │ Unlayered rules > all      │ .class{} > @layer a{.class  │
# │                 │ layered           │ layered rules              │ {}}                         │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ !important        │ Later-defined layer still  │ @layer b{!imp} > @layer a   │
# │                 │                   │ wins                       │ {!imp}                      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Same layer        │ Higher selector            │ #id{} > .class{}            │
# │                 │                   │ specificity wins / later   │                             │
# │                 │                   │ definition wins            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Priority order  │ Level 1           │ Unlayered + !important     │                             │
# │                 │                   │ (highest)                  │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Level 2           │ Later layer + !important   │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Level 3           │ Earlier layer + !important │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Level 4           │ Unlayered rules            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Level 5           │ Later layer rules          │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Level 6           │ Earlier layer rules        │                             │
# │                 │                   │ (lowest)                   │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Recommended     │ reset             │ Reset styles (lowest       │ *{margin:0;padding:0;}      │
# │ layers          │                   │ priority)                  │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ base              │ Base element styles        │ body{font:...} h1{...}      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ framework         │ Third-party frameworks     │ Bootstrap, Tailwind         │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ components        │ UI components              │ .button{} .card{}           │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ utilities         │ Utility classes            │ .text-center{} .m-0{}       │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ responsive        │ Responsive styles          │ @media{@layer responsive{}} │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ theme             │ Theme styles               │ @media(pres-color-scheme){} │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ overrides         │ Override styles (highest)  │ Page-specific styles        │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Full            │ Standard form     │ From lowest to highest     │ @layer reset,base,framework │
# │ declaration     │                   │ priority                   │ ,components,utilities,res   │
# │                 │                   │                            │ ponsive,theme,overrides;    │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Selector        │ In a layer        │ Depends on layer order     │ @layer a{#id{}}(100) <      │
# │ specificity     │                   │                            │ @layer b{.class{}}(10)      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Unlayered         │ Computed normally but >    │ .class{}(10) > @layer a     │
# │                 │                   │ all layers                 │ {#id{}}(100)                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ In practice     │ CSS Reset         │ reset layer                │ @layer reset{*{margin:0;    │
# │                 │                   │                            │ padding:0;box-sizing:       │
# │                 │                   │                            │ border-box;}}               │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Component library │ components layer           │ @layer components{.button   │
# │                 │                   │                            │ {padding:10px;border:none;  │
# │                 │                   │                            │ }}                          │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Framework         │ framework layer            │ @layer framework{           │
# │                 │ integration       │                            │ /*Bootstrrap*/}             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Utility classes   │ utilities layer            │ @layer utilities{.text-     │
# │                 │                   │                            │ center{text-align:center;}  │
# │                 │                   │                            │ }                           │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Theme system      │ theme layer                │ @layer theme{:root{--color  │
# │                 │                   │                            │ -primary:#007bff;}}         │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Responsive        │ Multi-breakpoint system    │ @media (min-w:768px)        │
# │                 │ layout            │                            │ {@layer responsive{         │
# │                 │                   │                            │ .container{max-width:720px  │
# │                 │                   │                            │ ;}}}                        │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Theme switching   │ Media query + layer        │ @media(pres-color-scheme:   │
# │                 │                   │                            │ dark){@layer theme{:root    │
# │                 │                   │                            │ {--bg-color:#1a1a1a;}}}     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Print styles      │ Print media query          │ @media print{@layer print   │
# │                 │                   │                            │ {body{font-size:12pt;}}}    │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Third-party       │ Separate layer             │ @layer                      │
# │                 │ libraries         │                            │ library{/*third-party code  │
# │                 │                   │                            │ */}                         │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Hotfixes          │ overrides layer            │ @layer overrides{.bug-fix   │
# │                 │                   │                            │ {...}}                      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Code style      │ Naming            │ Lowercase letters +        │ @layer base-components      │
# │                 │                   │ hyphens                    │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Order             │ Must be declared before    │ @layer a,b; at the very top │
# │                 │                   │ use                        │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Layer count       │ 5-8 layers is about right  │ Not too many                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Comments          │ Note what each layer is    │ /*Reset layer*/@layer       │
# │                 │                   │ for                        │ reset{}                     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Files             │ One file per layer         │ reset.css base.css comp.css │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @import           │ Must come first            │ @import url() layer();      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @media            │ Can go anywhere            │ Use flexibly                │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Common mistakes │ @import in the    │ Placed after rules         │ ✅ @import must come first  │
# │                 │ wrong place       │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Messy @media      │ Unclear which form to use  │ ✅ Prefer @media wrapping   │
# │                 │ nesting           │                            │ @layer                      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Declared too late │ Layers declared after      │ ✅ Declare before all rules │
# │                 │                   │ rules                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Using             │ Breaks layer priority      │ ✅ Use a higher layer       │
# │                 │ !important        │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Too many layers   │ Hard to maintain           │ ✅ Merge similar layers     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Unlayered         │ Unlayered rules override   │ ✅ Put unlayered rules into │
# │                 │ overrides         │ everything                 │ a layer                     │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Wrong layer       │ Confusing priorities       │ ✅ Order by priority        │
# │                 │ order             │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Best practices  │ ✓ DO              │ Put @import first          │ @import url() layer();      │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✓ DO              │ Wrap @layer in @media      │ @media{@layer responsive{}} │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✓ DO              │ Declare the layer order    │ @layer a,b; at the very top │
# │                 │                   │ first                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✓ DO              │ Order by priority          │ reset→base→components       │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✓ DO              │ Use semantic names         │ @layer components{}         │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✓ DO              │ Limit the number of layers │ 5-8 layers                  │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✗ DON'T           │ Put @import after rules    │ Makes it invalid            │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✗ DON'T           │ Use !important             │ Use a higher layer instead  │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✗ DON'T           │ Mix in unlayered rules     │ Put them in the right layer │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ ✗ DON'T           │ Create too many layers     │ Keep it simple              │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Compared with   │ where()           │ Specificity 0              │ :where(.class{})            │
# │ others          │                   │                            │ specificity 0               │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ :is()             │ Takes the highest          │ :is(#id,.class{})           │
# │                 │                   │ specificity                │ specificity 100             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @scope            │ Scope isolation            │ @scope(.container){}        │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Syntax cheat    │ @import           │ Import into a layer        │ @import url('a.css')        │
# │ sheet           │ url()             │                            │ layer(a)                    │
# │                 │ layer()           │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @media            │ Media query wrapping a     │ @media{@layer responsive{}} │
# │                 │ {@layer           │ layer                      │                             │
# │                 │ {}}               │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @layer            │ Media query inside a layer │ @layer base{@media{}}       │
# │                 │ {@media           │                            │                             │
# │                 │ {}}               │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @layer            │ Declare a layer            │ @layer base;                │
# │                 │ name;             │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @layer            │ Declare multiple layers    │ @layer a,b,c;               │
# │                 │ a,b,c;            │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @layer            │ Define a layer             │ @layer base{body{}}         │
# │                 │ name{}            │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ @layer            │ Nested layer               │ @layer a.b{}                │
# │                 │ a.b{}             │                            │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ Core principles │ 1                 │ @import must come first    │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ 2                 │ @media can go anywhere     │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ 3                 │ Later-defined layer >      │                             │
# │                 │                   │ earlier-defined layer      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ 4                 │ Unlayered rules > all      │                             │
# │                 │                   │ layers                     │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ 5                 │ !important follows layer   │                             │
# │                 │                   │ order                      │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ 6                 │ Within a layer, normal CSS │                             │
# │                 │                   │ rules apply                │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │ In one sentence │ Core value        │ Makes CSS priority clear   │                             │
# │                 │                   │ and controllable, resolves │                             │
# │                 │                   │ framework style conflicts, │                             │
# │                 │                   │ supports modular imports   │                             │
# ├─────────────────┼───────────────────┼────────────────────────────┼─────────────────────────────┤
# │                 │ Getting started   │ @layer                     │                             │
# │                 │                   │ reset,base,components      │                             │
# │                 │                   │ ,utilities,overrides;      │                             │
# └─────────────────┴───────────────────┴────────────────────────────┴─────────────────────────────┘
# 
# ### Specificity decision tree
# ┌─────────┬───────────────────────────┬─────────────────────────────┬────────────────────────────┐
# │ Node    │ Check                     │ Description                 │ Action                     │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 1  │ Any !important?           │ The most important check    │ Has it → wins; neither →   │
# │         │                           │                             │ step 2A                    │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 2A │ In a cascade layer?       │ Separate layered from       │ Layered → 2C; unlayered →  │
# │         │                           │ unlayered                   │ 5 (unlayered beats         │
# │         │                           │                             │ layered)                   │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 2B │ Compare layer order       │ When both have !important   │ Different layers → later   │
# │         │                           │                             │ layer wins; same layer →   │
# │         │                           │                             │ step 3                     │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 2C │ Compare layer order       │ Layered, no !important      │ Different layers → later   │
# │         │                           │                             │ layer wins; same layer →   │
# │         │                           │                             │ step 3A                    │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 3  │ Compare base specificity  │ Same layer, both !important │ Higher specificity → wins; │
# │         │                           │                             │ equal → step 4             │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 3A │ Compare base specificity  │ Layered, same layer, no     │ Higher specificity → wins; │
# │         │                           │ !important                  │ equal → step 4A            │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 4  │ Compare definition order  │ Same layer and specificity, │ Later definition wins      │
# │         │                           │ both !important             │                            │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 4A │ Compare definition order  │ Layered, same layer and     │ Later definition wins      │
# │         │                           │ specificity, no !important  │                            │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 5  │ Inline style?             │ Unlayered, no !important    │ Inline → wins; not inline  │
# │         │                           │                             │ → step 6                   │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 6  │ Compare selector          │ Unlayered, not inline       │ Higher specificity → wins; │
# │         │ specificity               │                             │ equal → step 7             │
# ├─────────┼───────────────────────────┼─────────────────────────────┼────────────────────────────┤
# │ Step 7  │ Compare definition order  │ Unlayered, same specificity │ Inline > internal >        │
# │         │                           │                             │ external; equal → later    │
# │         │                           │                             │ definition                 │
# └─────────┴───────────────────────────┴─────────────────────────────┴────────────────────────────┘
# In one sentence: !important is strongest → then @layer (unlayered beats layered) → higher
# specificity wins → the later one wins
#
# # Responsive layout
#
# ## @media (media queries)
#
# @media is CSS's media query rule; it applies different styles depending on device characteristics
# (such as screen width, height, resolution, etc.).
# 
# Basic syntax
# ```css
# @media media-type logical-operator (media-feature) {
#   /* CSS rules */
# }
# ```
#
#   Media types
#
# ┌────────┬──────────────────────────────────────┬────────────┐
# │ Type   │ Description                          │ How common │
# ├────────┼──────────────────────────────────────┼────────────┤
# │ all    │ All devices (default)                │ ⭐⭐⭐     │
# ├────────┼──────────────────────────────────────┼────────────┤
# │ screen │ Screens (computers, phones, tablets) │ ⭐⭐⭐⭐⭐ │
# ├────────┼──────────────────────────────────────┼────────────┤
# │ print  │ Printers                             │ ⭐⭐⭐     │
# ├────────┼──────────────────────────────────────┼────────────┤
# │ speech │ Speech synthesizers                  │ ⭐         │
# └────────┴──────────────────────────────────────┴────────────┘
#
#  Common media features
# ┌────────────────────────┬─────────────────────────┬───────────────────────────────┐
# │ Feature                │ Description             │ Example                       │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ min-width              │ Minimum viewport width  │ 768px                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ max-width              │ Maximum viewport width  │ 768px                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ min-height             │ Minimum viewport height │ 800px                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ max-height             │ Maximum viewport height │ 800px                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ device-width           │ Device width            │ Deprecated                    │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ device-height          │ Device height           │ Deprecated                    │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ orientation            │ Orientation             │ portrait | landscape          │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ aspect-ratio           │ Aspect ratio            │ 16/9                          │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ resolution             │ Resolution              │ min-resolution: 2dppx         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ min-resolution         │ Minimum resolution      │ min-resolution: 192dpi        │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ max-resolution         │ Maximum resolution      │ max-resolution: 300dpi        │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ scan                   │ Scan method             │ interlace | progressive       │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ grid                   │ Grid support            │ 0 | 1                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ display-mode           │ Display mode            │ fullscreen | standalone       │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ update                 │ Update frequency        │ none | slow | fast            │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ hover                  │ Hover capability        │ hover | none                  │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ any-hover              │ Any hover               │ hover | none                  │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ pointer                │ Pointer type            │ fine | coarse                 │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ any-pointer            │ Any pointer             │ fine | coarse                 │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ color-gamut            │ Color gamut             │ srgb | p3 | rec2020           │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ color-index            │ Color index             │ 256                           │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ monochrome             │ Monochrome              │ 0 | 1                         │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ inverted-colors        │ Inverted colors         │ inverted | none               │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ forced-colors          │ Forced colors           │ active | none                 │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ prefers-color-scheme   │ Color scheme            │ dark | light                  │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ prefers-reduced-motion │ Motion preference       │ reduce | no-preference        │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ prefers-reduced-data   │ Data usage preference   │ reduce | no-preference        │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ prefers-contrast       │ Contrast preference     │ more | less | custom          │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ overflow-block         │ Block-axis overflow     │ scroll | optional | none      │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ overflow-inline        │ Inline-axis overflow    │ scroll | optional | none      │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ scripting              │ Scripting support       │ none | initial-only | enabled │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ transform-3d           │ 3D transforms           │ none | preserve-3d            │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ transition             │ Transition support      │ none                          │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ animation              │ Animation support       │ none                          │
# ├────────────────────────┼─────────────────────────┼───────────────────────────────┤
# │ video-dynamic-range    │ Video dynamic range     │ standard | high               │
# └────────────────────────┴─────────────────────────┴───────────────────────────────┘
#
# Logical operators
# ┌────────────┬───────────────────────────────────────────┬───────────────────────────────┐
# │ Operator   │ Description                               │ Example                       │
# ├────────────┼───────────────────────────────────────────┼───────────────────────────────┤
# │ and        │ And (all must match)                      │ screen and (min-width: 768px) │
# ├────────────┼───────────────────────────────────────────┼───────────────────────────────┤
# │ or (comma) │ Or (any one matches)                      │ screen, print                 │
# ├────────────┼───────────────────────────────────────────┼───────────────────────────────┤
# │ not        │ Not (negation)                            │ not print                     │
# ├────────────┼───────────────────────────────────────────┼───────────────────────────────┤
# │ only       │ Only (keeps old browsers from misreading) │ only screen and (...)         │
# └────────────┴───────────────────────────────────────────┴───────────────────────────────┘
#
# Quick reference
#
# ```css
# @media screen and (min-width: 768px) { }/* basic syntax */
# @media (min-width: 768px) and (max-width: 1024px) { }/* multiple conditions */
# @media (min-width: 768px), print { } /* or: any one condition is enough */
# @media not print { } /* negation */
# @media (prefers-color-scheme: dark) { } /* dark mode */
# @media (prefers-reduced-motion: reduce) { }
# @media (min-width: 576px) { /* ... */ }  /* large phones */
# @media (min-width: 768px) { /* ... */ }  /* tablets */
# @media (min-width: 992px) { /* ... */ }  /* small desktops */
# @media (min-width: 1200px) { /* ... */ } /* large desktops */
# @media print { } /* when printing */
# @media screen and (orientation: portrait) { } /* portrait */
# @media screen and (orientation: landscape) { } /* landscape */
# @media (prefers-reduced-motion: reduce) { } /* user prefers reduced motion */
# /* high-resolution screens */
# @media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) { }
# /* tablet landscape */
# @media screen and (min-width: 768px) and (orientation: landscape) { }
# @media (min-width: 1200px), print { } /* large screens or print */
# @media not print { } /* non-print devices */
# ```
#
#
#
# ## Example
# ```html
# <!DOCTYPE html>
# <html lang="zh-CN">
# <head>
#     <meta charset="UTF-8">
#     <meta name="viewport" content="width=device-width, initial-scale=1.0">
#     <title>Complete CSS Selector Tutorial - All 54 Selectors</title>
#     <style>
#         /* ========== Global styles ========== */
#         * {
#             margin: 0;
#             padding: 0;
#             box-sizing: border-box;
#         }
