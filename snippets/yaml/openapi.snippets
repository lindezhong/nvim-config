snippet openapiInit openapi initialization
	openapi: 3.0.4
	info:
	  title: Swagger Petstore - OpenAPI 3.0
	  description: |-
	    ${1:detailed description, supports markdown syntax}
	  termsOfService: ${2:http://localhost}
	  contact:
	    email: ${3:2872611588@qq.com}
	  license:
	    name: Apache 2.0
	    url: https://www.apache.org/licenses/LICENSE-2.0.html
	  version: 1.0.12
	externalDocs:
	  description: ${4:additional external documentation}
	  url: ${5:http://localhost}
	servers:
	  - url: ${6:http://localhost/api/v1} 
	tags:
	  openapiTag$0
	paths:
	  openapiPath
	components:
	  schemas:
	    Response:
	      type: object
	      properties:
	        code:
	          type: integer
	          format: int32
	        data:
	          type: object
	        message:
	          type: string
	    Error:
	      type: object
	      properties:
	        code:
	          type: string
	        message:
	          type: string
	      required:
	        - code
	        - message
	    openapiComponentSchema

snippet openapiTag define a tag that groups paths; a tag holds multiple paths, and a path can have multiple tags so it appears under each of them
	- name: ${1:tag_name}
	  description: ${2:tag description}
	  externalDocs:
	    description: ${3:additional external documentation}
	    url: ${4:http://localhost}

snippet openapiPath define a request path
	${1:/path}:
	  ${2:get, head, post, put, patch, delete, options, trace}:
	    tags:
		  - ${3:tag}
	    summary: ${4:summary}
	    description: ${5:description}
	    operationId: ${6:id}
	    openapiRequest$0
	    responses:
	      '200':
		      description: Successful
	        content:
			      openapiPathContent
	      default:
	        description: Unexpected error
	        content:
	          application/json:
	            schema:
	              $ref: "#/components/schemas/Error"

snippet openapiRequestBody requestBody is the body of the request (not the url part), usually used in POST, PUT, PATCH etc. to send large or complex data
	requestBody:
	  description: ${1:body description}
	  content:
	    openapiPathContent$0
	  required: true

snippet openapiPathContentJsonRef requestBody json format, references a reusable object (components/schemas/Object)
	application/json:
	  schema:
	    $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormRef requestBody simple form format, only simple key value pairs, references a reusable object (components/schemas/Object); form data is essentially passed like url parameters, spring mvc reads it with @RequestParam or @ModelAttribute, curl example curl -X POST -H 'Content-Type: application/x-www-form-urlencoded'  -d 'name=John&age=30' http://localhost:8080/submit
	application/x-www-form-urlencoded:
	  schema:
	    $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormDataRef requestBody complex form format, can send complex objects (files together with complex parameters such as arrays), references a reusable object (components/schemas/Object); form-data separates parts with a boundary, spring mvc reads it with @RequestParam, curl example curl -X POST http://localhost:8080/upload -H 'Content-Type: multipart/form-data' -F 'file=@/path/to/your/file.txt' -F 'description=This is a sample description'
	application/x-www-form-urlencoded:
	  schema:
	    $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentJsonListRef requestBody list json format, references a reusable object (components/schemas/Object)
	application/json:
	  schema:
	    type: array
	    items:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormListRef requestBody list simple form format, only simple key value pairs, references a reusable object (components/schemas/Object); form data is essentially passed like url parameters, spring mvc reads it with @RequestParam or @ModelAttribute, curl example curl -X POST -H 'Content-Type: application/x-www-form-urlencoded'  -d 'name=John&age=30' http://localhost:8080/submit
	application/x-www-form-urlencoded:
	  schema:
	    type: array
	    items:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormDataListRef requestBody list complex form format, can send complex objects (files together with complex parameters such as arrays), references a reusable object (components/schemas/Object); form-data separates parts with a boundary, spring mvc reads it with @RequestParam, curl example curl -X POST http://localhost:8080/upload -H 'Content-Type: multipart/form-data' -F 'file=@/path/to/your/file.txt' -F 'description=This is a sample description'
	application/x-www-form-urlencoded:
	  schema:
	    type: array
	    items:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentJsonMapRef requestBody Map json format, references a reusable object (components/schemas/Object)
	application/json:
	  schema:
	    type: object
	    additionalProperties:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormMapRef requestBody Map simple form format, only simple key value pairs, references a reusable object (components/schemas/Object); form data is essentially passed like url parameters, spring mvc reads it with @RequestParam or @ModelAttribute, curl example curl -X POST -H 'Content-Type: application/x-www-form-urlencoded'  -d 'name=John&age=30' http://localhost:8080/submit
	application/x-www-form-urlencoded:
	  schema:
	    type: object
	    additionalProperties:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiPathContentFormDataMapRef requestBody Map complex form format, can send complex objects (files together with complex parameters such as arrays), references a reusable object (components/schemas/Object); form-data separates parts with a boundary, spring mvc reads it with @RequestParam, curl example curl -X POST http://localhost:8080/upload -H 'Content-Type: multipart/form-data' -F 'file=@/path/to/your/file.txt' -F 'description=This is a sample description'
	application/x-www-form-urlencoded:
	  schema:
	    type: object
	    additionalProperties:
	      $ref: '#/components/schemas/${1:Object}'

snippet openapiRequestParameters request parameters that appear in the url
	parameters:
	  openapiRequestParametersItem

snippet openapiRequestParametersItemInteger request parameter in url, header or cookie, parameter type integer
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:0}
	    type: integer
	    format: int32

snippet openapiRequestParametersItemLong request parameter in url, header or cookie, parameter type long
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:0}
	    type: integer
	    format: int64

snippet openapiRequestParametersItemFloat request parameter in url, header or cookie, parameter type float
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:0.0}
	    type: number
	    format: float

snippet openapiRequestParametersItemDouble request parameter in url, header or cookie, parameter type double
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:0.0}
	    type: number
	    format: double

snippet openapiRequestParametersItemString request parameter in url, header or cookie, parameter type string
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:}
	    type: string

snippet openapiRequestParametersItemBoolean request parameter in url, header or cookie, parameter type boolean
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:true}
	    type: boolean

snippet openapiRequestParametersItemDate request parameter in url, header or cookie, parameter type date, date format: YYYY-MM-DD, e.g. 1970-01-01
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:1970-01-01}
	    type: string
	    format: date

snippet openapiRequestParametersItemEnum request parameter in url, header or cookie, parameter type enum
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  explode: true
	  schema:
	    default: ${5:}
	    type: string
	    enum:
	      - $5

snippet openapiRequestParametersItemDateTime request parameter in url, header or cookie, parameter type dateTime, non-UTC date format: YYYY-MM-DDTHH:MM:SS± HH:MM(1970-01-01T00:00:00+08:00), UTC date format: YYYY-MM-DDTHH:MM:SSZ(1970-01-01T00:00:00Z)
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  schema:
	    default: ${5:1970-01-01T00:00:00Z}
	    type: string
	    format: date-time

snippet openapiRequestParametersItemArray request parameter in url, header or cookie, parameter type array, use `,` to separate array items
	- name: ${1:parameter_name}
	  in: ${2:query,header,path,cookie}
	  description: ${3:parameter_description}
	  required: ${4:true}
	  explode: true
	  schema:
	    default: ${5:1,2}
	    type: array
	    items:
	      type: ${6:integer,number,string,boolean}

snippet openapiComponentSchema define a reusable object, used via `$ref: '#/components/schemas/SchemaName'`
	${1:SchemaName}:
	  required:
	    - field_name
	  type: object
	  properties:
	    openapiComponentSchemaField$0

snippet openapiComponentSchemaFieldInteger reusable object field integer
	${1:field_name}:
	  type: integer
	  format: int32
	  description: ${2:int}
	  example: ${3:0}

snippet openapiComponentSchemaFieldLong reusable object field long
	${1:field_name}:
	  type: integer
	  format: int64
	  description: ${2:long}
	  example: ${3:0}

snippet openapiComponentSchemaFieldFloat reusable object field float
	${1:field_name}:
	  type: number
	  format: float
	  description: ${2:float}
	  example: ${3:0.0}

snippet openapiComponentSchemaFieldDouble reusable object field double
	${1:field_name}:
	  type: number
	  format: double
	  description: ${2:double}
	  example: ${3:0.0}

snippet openapiComponentSchemaFieldString reusable object field string
	${1:field_name}:
	  type: string
	  description: ${2:string}
	  example: ${3:}

snippet openapiComponentSchemaFieldEnum reusable object field enum
	${1:field_name}:
	  type: string
	  description: ${2:string}
	  example: ${3:}
	  enum:
	    - $3

snippet openapiComponentSchemaFieldBoolean reusable object field boolean
	${1:field_name}:
	  type: boolean
	  description: ${2:string}
	  example: ${3:true}

snippet openapiComponentSchemaFieldPassword reusable object field password, tells the UI not to show the input in plain text.
	${1:field_name}:
	  type: string
	  format: password
	  description: ${2:password}
	  example: ${3:}

snippet openapiComponentSchemaFieldDate reusable object field date, date format: YYYY-MM-DD, e.g. 1970-01-01
	${1:field_name}:
	  type: string
	  format: date
	  description: ${2:date}
	  example: ${3:1970-01-01}

snippet openapiComponentSchemaFieldDateTime reusable object field dateTime, non-UTC date format: YYYY-MM-DDTHH:MM:SS± HH:MM(1970-01-01T00:00:00+08:00), UTC date format: YYYY-MM-DDTHH:MM:SSZ(1970-01-01T00:00:00Z)
	${1:field_name}:
	  type: string
	  format: date-time
	  description: ${2:dateTime}
	  example: ${3:1970-01-01T00:00:00Z}

snippet openapiComponentSchemaFieldByte reusable object field byte, binary data base64-encoded as a string, e.g. `ZGF0YQo=` 
	${1:field_name}:
	  type: string
	  format: byte
	  description: ${2:byte}
	  example: ${3:ZGF0YQo=}

snippet openapiComponentSchemaFieldBinary reusable object field binary, raw binary data, usually a file, sent with curl --data-binary, e.g. curl -X POST 'http://example.com/upload' -H 'Content-Type: application/octet-stream' --data-binary @path/to/your/file 
	${1:field_name}:
	  type: string
	  format: binary
	  description: ${2:binary}
	  example: ${3:}

snippet openapiComponentSchemaFieldArray reusable object field array, item type is a simple type
	${1:field_name}:
	  type: array
	  description: ${2:array}
	  example: [${3:}]
	  items:
	    type: ${4:integer,number,string,boolean}

snippet openapiComponentSchemaFieldArrayObject reusable object field array, item type is an object
	${1:field_name}:
	  type: array
	  description: ${2:array}
	  example: [${3:}]
	  items:
	    type: object
	    properties:
	      openapiComponentSchemaField$0

snippet openapiComponentSchemaFieldArrayRef reusable object field array, item type references another object
	${1:field_name}:
	  type: array
	  description: ${2:array}
	  example: [${3:}]
	  items:
	    $ref: "#/components/schemas/${4:Object}"

snippet openapiComponentSchemaFieldMap reusable object field map, key is always string and cannot be specified, value type is a simple type
	${1:field_name}:
	  type: object
	  description: ${2:map}
	  example: {"key": ${3:value}}
	  additionalProperties:
	    type: ${4:integer,number,string,boolean}

snippet openapiComponentSchemaFieldMapObject reusable object field map, key is always string and cannot be specified, value type is an object
	${1:field_name}:
	  type: object
	  description: ${2:map}
	  example: {"key": ${3:value}}
	  additionalProperties:
	    type: object
	    properties:
	      openapiComponentSchemaField$0

snippet openapiComponentSchemaFieldMapRef reusable object field map, key is always string and cannot be specified, value type references another object
	${1:field_name}:
	  type: object
	  description: ${2:map}
	  example: {"key": ${3:value}}
	  additionalProperties:
	    $ref: "#/components/schemas/${5:Object}"

snippet openapiComponentSchemaFieldRef reusable object field ref, references another object
	${1:field_name}:
	  $ref: "#/components/schemas/${2:Object}"
