#######################################
########sqlalchemy is an orm framework########
#######################################

# Installation
# 1. pip3 install mysql-connector sqlalchemy



snippet sqlEngineMysql sqlalchemy create a MySql engine, 1. from sqlalchemy.engine.create import create_engine 2. pip3 install mysql-connector 3. connect_args={'auth_plugin': 'mysql_native_password'} if the MySQL password uses mysql_native_password auth 4. acts as a connection pool; the number of connections can also be set
	${6:engine} = create_engine('mysql+mysqlconnector://${1:username}:${2:password}@${3:IP address}:${4:port}/${5:database name}')
	$0

snippet sqlSession sqlalchemy create a Session; database operations go through the Session. 1. needs the engine created by sqlEngineMysql (snippet) 2. from sqlalchemy.orm import sessionmaker 3. from sqlalchemy.orm.session import Session  4. after use call session.commit() and session.close() to return the connection to the pool 5. orm operations use the session; a session is like a connection
	${2:DBSession} = sessionmaker(bind=${1:engine})
	${3:session} :Session = $2()
	$0

# tablename sets the table name the model maps to. In the Player model, the variable names must
# match the column names in the table, and each column is defined with Column
# 
# | Type     | Description                           | Usage                                       |
# |----------+---------------------------------------+---------------------------------------------|
# | Integer  | integer type                          | Column(Integer, primary_key=True,           |
# |          |                                       | autoincrement=True)                         |
# | Float    | floating-point type                   | Column(Float(3, 2))                         |
# | Decimal  | fixed-point type                      |                                             |
# | Boolean  | boolean type                          |                                             |
# | Date     | datetime.date date type               |                                             |
# | Time     | datetime.time time type               |                                             |
# | String   | string type, length required, unlike  | Column(String(255))                         |
# |          | Text                                  |                                             |
# | Text     | text type                             |                                             |
# | enum     | enum type                             |                                             |
# | LONGTEXT | long text type                        |                                             |
# 
# Besides the Column data type, we can also pass Column arguments that create column constraints:
# 
# | Attribute     | Description                        |
# |---------------+------------------------------------|
# | default       | default value                      |
# | nullable      | whether it can be null             |
# | primary_key   | whether it is the primary key      |
# | unique        | whether it is unique               |
# | autoincrement | whether it auto-increments         |
# | onupdate      | function executed on update        |
# | name          | column name mapped in the database |
snippet sqlModel sqlalchemy create a model for database mapping 1. from sqlalchemy.sql.schema import Column 2. from sqlalchemy.sql.sqltypes import String, Integer ,Float 3. from sqlalchemy.ext.declarative import declarative_base 
	class ${1:class_name}(declarative_base()):
	    __tablename__ = '${2:table_name}'
	    # table structure
	    id = Column(Integer, primary_key=True, autoincrement=True)
		$0
