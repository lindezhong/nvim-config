# ##match (switch) statement#Flow control
# ```python
# from dataclasses import dataclass
# 
# status=400 # output: http status=400
# # '|' : an or condition
# match status:
#     case 400 | 404:
#         print(f"http status={status}")
#     # '_' : wildcard that matches anything
#     case _:
#         pass
# 
# point=(1,2) # output x=1 , y = 2
# # point=(1,2,3) # raises an exception
# # match a tuple
# match point:
#     case (0, 0):
#         print("Origin")
#     case (0, y):
#         print(f"{y = }")
#     case (x, 0):
#         print(f"{x = }")
#     case (x,y):
#         print(f"{x = } , {y = }")
#     case _:
#         raise ValueError("Not a point")
# 
# @dataclass
# class Point:
#     x: int
#     y: int
# point=Point(x=1, y=2) # output: x = 1 , y = 2
# #point=Point(x=1, y=1) # output: Y=X at 1
# # match an object
# match point:
#     case Point(x=0, y=0):
#         print("Origin")
#     case Point(x=0, y=y):
#         print(f"{y = }")
#     case Point(x=x, y=0):
#         print(f"{x = }")
#     # add an if clause to a pattern, known as a guard. If the guard is false, match goes on to try
#     the next case block. Note that value capture happens before the guard is evaluated:
#     case Point(x, y) if x == y:
#         print(f"Y=X at {x}")
#     case Point():
#         print(f"{x = } , {y = }")
#     case _:
#         raise ValueError("Not a point")
# point1=Point(x=1, y=3)
# point2=Point(x=1, y=3)
# point=(point1, point2) # output: p1=(p1.x = 1,p1.y = 3) , p2=(p2.x = 1,p2.y = 3)
# # match a tuple of objects; use as to capture subpatterns
# match point:
#     case (Point(x1, y1) as p1 , Point(x2, y2) as p2) if y1 == y2 and x2 == x1:
#         print(f"p1=({p1.x = },{p1.y = }) , p2=({p2.x = },{p2.y = })")
# ```
snippet switch switch statement, '|' : an or condition, the matched value can be '_', an object, or unpacking (tuple); '_' : wildcard that matches anything; can match objects as long as the values are initialized
	match ${1:object to match}:
	    case ${2:value to match}:
			pass$0
		case _:
			pass

# ##Functions function#Flow control
# ###Parameters##Functions function#Flow control
# ```python
# # 1. Default values and keywords : keyword arguments of the form kwarg=value,
# def parrot(voltage, state='a stiff', action='voom', type='Norwegian Blue'):
#     pass
# # This function accepts one required argument (voltage) and three optional arguments (state,
# action, and type). It can be called in any of the following ways:
# parrot(1000)                                          # 1 positional argument
# parrot(voltage=1000)                                  # 1 keyword argument
# parrot(voltage=1000000, action='VOOOOOM')             # 2 keyword arguments
# parrot(action='VOOOOOM', voltage=1000000)             # 2 keyword arguments
# parrot('a million', 'bereft of life', 'jump')         # 3 positional arguments
# parrot('a thousand', state='pushing up the daisies')  # 1 positional, 1 keyword
# 
# # 2. Special parameters '/' : positional-only parameters go before / (forward slash), '*' : put *
# before keyword-only parameters
# def combined_example(pos_only, /, standard, *, kwd_only):
#     print(pos_only, standard, kwd_only)
# combined_example(1, 2, kwd_only=3) # output: 1 2 3
# combined_example(1, standard=2, kwd_only=3) # output: 1 2 3
# 
# # 3. Arbitrary argument lists and unpacking argument lists
# def cheeseshop(kind, *arguments, **keywords):
#     pass
# cheeseshop("Limburger", "It's very runny, sir.","It's really very, VERY runny,
# sir.",shopkeeper="Michael Palin",client="John Cleese")
# args,dists=[1,2],{"k": "v"}
# cheeseshop("Limburger", *args, **dists)
# ```
# ###lambda expressions##Functions function#Flow control
# ```python
# def make_incrementor(n: int) :
#     return lambda x: x + n
# f = make_incrementor(42)
# print(f(1)) # output: 43
# 
# # lambda as an argument:
# pairs: List[Tuple[int, str]] = [(1, 'one'), (2, 'two'), (3, 'three'), (4, 'four')]
# pairs.sort(key = lambda pair: pair[1])
# print(pairs) # output: [(4, 'four'), (1, 'one'), (3, 'three'), (2, 'two')]
# ```
snippet lambda lambda expression, expression can only be one line
	lambda ${1:arguments}: ${2:expression}

# #Modules
# ##dir() function#Modules
# The built-in function dir() is used to find out which names (variables, modules, functions) a
# module defines. It returns a sorted list of strings
# dir() does not list the names of built-in functions and variables. They are defined in the
# standard module builtins
