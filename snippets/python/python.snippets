# ##Generators#Built-in types
# In Python, a function that uses yield is called a generator.
# Unlike a normal function, a generator is a function that returns an iterator and can only be used
# for iteration; put simply, a generator is an iterator.
# While a generator runs, each time it hits yield the function pauses and saves all of its current
# state, returns the value of yield, and resumes from that point the next time next() is called.
# Calling a generator function returns an iterator object.
#!/usr/bin/python3
# ```python
# import sys
# def fibonacci(n): # generator function - Fibonacci
#     a, b, counter = 0, 1, 0
#     while True:
#         if (counter > n):
#             return
#         yield a
#         a, b = b, a + b
#         counter += 1
# f = fibonacci(10) # f is an iterator returned by the generator
# while True:
#     try:
#         print (next(f), end=" ")
#     except StopIteration:
#         sys.exit()
# ```
# ##Sequence types#Built-in types
# ###Common operations##Sequence types#Built-in types
# - x in s : True if an item of s is equal to x, else False. While in and not in are generally used
#   only for simple containment testing, some specialised sequences (such as str, bytes and
#   bytearray) also use them for subsequence testing: `"gg" in "eggs"` # ture
# - x not in s : False if an item of s is equal to x, else True
# - s.extend(t) or s + t : the concatenation of s and t
# - s * n or n * s : equivalent to adding s to itself n times
# - s[i] : the i-th item of s, origin 0
# - s[i:j] : slice of s from i to j (shallow copy)
# - s[i:j:k] : slice of s from i to j with step k (shallow copy)
# - len(s) : length of s
# - min(s) : smallest item of s
# - max(s) : largest item of s
# - s.index(x[, i[, j]]) : index of the first occurrence of x in s (at or after index i and before
#   index j)
# - s.count(x) : total number of occurrences of x in s
# - s[i] = x : item i of s is replaced by x
# - s[i:j] = t : slice of s from i to j is replaced by the contents of the iterable t
# - del s[i:j] : same as s[i:j] = []
# - s.append(x) : appends x to the end of the sequence (same as s[len(s):len(s)] = [x])
# - s.clear() : removes all items from s (same as del s[:]). clear() and copy() are included for
#   consistency with the interfaces of mutable containers that don't support slicing operations
#   (such as dict and set). copy() is not part of the collections.abc.MutableSequence ABC, but most
#   concrete mutable sequence classes provide it.
# - s.copy() : creates a shallow copy of s (same as s[:])
# - s.insert(i, x) : inserts x into s at the index given by i (same as s[i:i] = [x])
# - s.pop() or s.pop(i) : retrieves the item at i and also removes it from s
# - s.remove(x) : removes the first item from s where s[i] is equal to x.
# - s.reverse() : reverses the items of the list in place.
# - del s[i:j] : removes the slice from the list
# - del s : deletes the whole variable; referencing s afterwards raises an error (until another
#   value is assigned to it)
# ###Types##Sequence types#Built-in types
# - list : appending and popping at the end of a list is fast, but inserting or removing at the
#   beginning is slow (because all of the other elements have to be shifted by one)
# - collections.deque : fast appends and pops from both ends queue = deque(["Eric", "John",
#   "Michael"])
# - tuple : tuples are immutable and support packing: t = 'hello','python';  unpacking: x,y = t;
# - range
# ###List comprehensions##Sequence types#Built-in types
# A list comprehension applies an operation to each element of a sequence or iterable and builds a
# new list from the results, or builds a subsequence of the elements that satisfy a condition
# (list comprehensions can be nested) the format is : [expression for variable in list {if
# condition: optional}]/[out_exp_res for out_exp in input_list {if condition: optional}]
# ```python
# # these two are equivalent
# squares=[x*y for x in range(1,5) if x > 2 for y in range(1,4) if y < 3]
# squares=[]
# for x in range(1,5)
#     if x > 2
#         for y in range(1,4)
#             if y < 3
#                 squares.append(x*y)
# ```
# ###Tuple comprehensions##Sequence types#Built-in types
# Tuple comprehension format (can be nested): (expression for item in Sequence if conditional )
# ##Set types set#Built-in types
# Being an unordered collection, sets do not record element position or order of insertion.
# Accordingly, sets do not support indexing, slicing, or other sequence-like behavior
# - a set object is an unordered collection of distinct hashable objects (hashable meaning the
#   object has __hash__() and __eq__() methods).
# - the frozenset type is immutable and hashable --- its contents cannot be altered after it is
#   created; it can therefore be used as a dictionary key or as an element of another set.
# Common set, frozenset operations
# - set <= other : test whether every element in the set is in other.
# - set < other : test whether the set is a proper subset of other, that is, set <= other and set !=
#   other.
# - set | other | ... : return a new set with elements from the set and all others.
# - set & other & ... : return a new set with elements common to the set and all others.
# - set - other - ... : return a new set with elements in the set that are not in the others.
# - set ^ other : return a new set with elements in either the set or other but not both.
# - set |= other | ... : update the set, adding elements from all others. (not available on
#   frozenset)
# - set &= other & ... : update the set, keeping only elements found in it and all others. (not
#   available on frozenset)
# - set -= other | ... : update the set, removing elements found in others. (not available on
#   frozenset)
# - set ^= other : update the set, keeping only elements found in either set, but not in both. (not
#   available on frozenset)
# ```python
# setVar :set = {"a", "b", "c"}
# setVar :set = set(["a", "b", "c"])
# frozensetVar :frozenset = frozenset(["a", "b", "c"])
# print(setVar) # output : {'c', 'a', 'b'}
# ```
# ###Set comprehensions##Set types set#Built-in types
# Set comprehension format (can be nested): { expression for item in Sequence if conditional }
# ##Mapping types map#Built-in types
# ###Dict comprehensions##Mapping types map#Built-in types
# Dict comprehension format (can be nested): { key_expr: value_expr for value in collection if
# condition }
# A mapping object maps hashable values to arbitrary objects. Mappings are mutable objects. There is
# currently only one standard mapping type, the dictionary.
# Common operations
# - d[key] = value : set d[key] to value.
# - del d[key] : remove d[key] from d. Raises a KeyError if key is not in the map.
# - key in d : return True if d has a key key, else False.
# - iter(d) : return an iterator over the keys of the dictionary. This is a shortcut for
#   iter(d.keys()).
# - get(key[, default]) : return the value for key if key is in the dictionary, else default. If
#   default is not given, it defaults to None, so that this method never raises a KeyError.
# - items() : return a new view of the dictionary's items ((key, value) pairs).
# - keys() : return a new view of the dictionary's keys. See the documentation of view objects.
# - values() : return a new view of the dictionary's values. See the documentation of view objects.
# - pop(key[, default]) : if key is in the dictionary, remove it and return its value, else return
#   default. If default is not given and key is not in the dictionary, a KeyError is raised.
# - popitem() : remove and return a (key, value) pair from the dictionary. Pairs are returned in
#   LIFO order. popitem() is useful to destructively iterate over a dictionary, as often used in set
#   algorithms. If the dictionary is empty, calling popitem() raises a KeyError.
# - reversed(d) : return a reverse iterator over the keys of the dictionary. This is a shortcut for
#   reversed(d.keys()).
# - setdefault(key[, default]) : if key is in the dictionary, return its value. If not, insert key
#   with a value of default and return default. default defaults to None.
# - d | other : create a new dictionary with the merged keys and values of d and other, which must
#   both be dictionaries. The values of other take priority when d and other share keys.
# - d |= other : update the dictionary d with keys and values from other, which may be either a
#   mapping or an iterable of key/value pairs. The values of other take priority when d and other
#   share keys.
# ```python
# mapVar = {x: x ** 2 for x in range(10)} # dict comprehension
# a = dict(one=1, two=2, three=3)
# b = {'one': 1, 'two': 2, 'three': 3}
# c = dict(zip(['one', 'two', 'three'], [1, 2, 3]))
# d = dict([('two', 2), ('one', 1), ('three', 3)])
# e = dict({'three': 3, 'one': 1, 'two': 2})
# f = dict({'one': 1, 'three': 3}, two=2)
# print(a == b == c == d == e == f) # output True
# print(list(d)) # output ['one', 'two', 'three'] returns a list of all the keys used in the
# dictionary d.
# print(len(d)) # output 3 returns the number of items in the dictionary d
# print(d['one']) # output 1 returns the item of d with key key. Raises a KeyError if key is not in
# the map.
# for k,v in a.items()
# 	print("key : {k} , value : {v}".format(k=k,v=v))
# # If a subclass of dict defines a method __missing__() and key is not present, the d[key]
# operation calls that method with the key key as argument. The d[key] operation then returns or
# raises whatever is returned or raised by the __missing__(key) call. No other operations or methods
# invoke __missing__(). If __missing__() is not defined, KeyError is raised. __missing__() must be a
# method; it cannot be an instance variable:
# class Counter(dict):
#     def __missing__(self, key):
#         print(key)
#         return 0
# c = Counter()
# print(c['red']) # output 0
# c['red'] += 1
# print(c['red']) # output 1
# ```
# ###Dictionary view objects##Mapping types map#Built-in types
# The objects returned by dict.keys(), dict.values() and dict.items() are view objects. They provide
# a dynamic view on the dictionary's entries, which means that when the dictionary changes, the view
# reflects these changes.
# Supported operations : 1. len(dictview) 2. iter(dictview) 3. x in dictview 4. reversed(dictview)
# 5. dictview.mapping (returns a types.MappingProxyType that wraps the original dictionary to which
# the view refers.)
# ##Context managers (AutoCloseable)#Built-in types
# A context manager runs some code before a block executes, for setup work, and some code after it,
# for cleanup. For example, after opening a file for reading/writing it must be closed; in database
# operations you connect before and close the connection after. The context management protocol has
# two methods, __enter__ and __exit__, which implement these two parts.
# ###with syntax##Context managers (AutoCloseable)#Built-in types
# ```python
# with EXPR as VAR:
#     BLOCK
# ```
# - evaluate EXPR to get the context manager
# - call the context manager's __enter__ method, which does the setup work.
# - as VAR is optional; if present, the return value of __enter__ is assigned to VAR.
# - execute the code block BLOCK, where VAR can be used like a normal variable.
# - finally call the context manager's __exit__ method.
# - __exit__ takes three arguments: exc_type, exc_val, exc_tb. If BLOCK raised and exited, they are
#   the exception's type, value and traceback; otherwise all three are None.
# - __exit__ can return True or False. True means the exception is suppressed, as if handled by
#   try-except; False means the exception is re-raised.
# ```python
# # custom file-open operation
# class MyOpen(object):
#     def __init__(self, file_name):
#         """initializer"""
#         self.file_name = file_name
#         self.file_handler = None
#         return
#     def __enter__(self):
#         """enter method, returns file_handler"""
#         print("enter:", self.file_name)
#         self.file_handler = open(self.file_name, "r")
#         return self.file_handler
#     def __exit__(self, exc_type, exc_val, exc_tb):
#         """exit method, closes the file and returns True"""
#         print("exit:", exc_type, exc_val, exc_tb) # output : exit: <class 'ZeroDivisionError'>
#         <traceback object at 0x7f8a557ee9c0>
#         if self.file_handler:
#             self.file_handler.close()
#         return True
# # usage example
# with MyOpen("python_base.py") as file_in:
#     for line in file_in:
#         print(line)
#         raise ZeroDivisionError
# # the block deliberately raises a division-by-zero error, but the program as a whole does not
# raise
# ```
# ###Using the built-in contextlib library##Context managers (AutoCloseable)#Built-in types
# ```python
# import contextlib
# # the contextmanager decorator runs the code before a function's yield as __enter__ and the code
# after yield as __exit__. The value yielded is assigned to the variable after as.
# @contextlib.contextmanager
# def open_file(file_name):
#     # __enter__ method
#     print('open file:', file_name, 'in __enter__')
#     file_handler = open(file_name, 'r')
# 
#     try:
#         yield file_handler
#     finally:
#         # __exit__ method
#         print('close file:', file_name, 'in __exit__')
#         file_handler.close()
#     # reached here when no exception is raised
#     print("exit")
# with open_file("./hello.py") as file_in:
#     for line in file_in:
#         print(line)
#         raise ZeroDivisionError
# ```
# ```python
# # the closing class automatically calls the close method of the object passed in. Usage example:
# import contextlib
# class MyOpen2(object):
#     def __init__(self, file_name):
#         """initializer"""
#         self.file_handler = open(file_name, "r")
#         return
# 
#     def close(self):
#         """close the file, called automatically"""
#         print("call close in MyOpen2")
#         if self.file_handler:
#             self.file_handler.close()
#         return
# with contextlib.closing(MyOpen2("./hello.py")) as file_in:
#     for line in file_in:
#         print(line)
#         raise ZeroDivisionError
# ```
