snippet autoCloseable auto-closing resource class, used with the with syntax, try_resources (snippet)
	class ${1:class_name}(object):
	    def __init__(self):
	        pass
	    def __enter__(self):
	        """enter method, returns file_handler"""
	        self.resource = ${2:initialize resource}
	        return self.resource
	    def __exit__(self, exc_type, exc_val, exc_tb):
	        """exit method, closes the resource and returns True (exception suppressed, as if handled by try-except) or False (exception re-raised)"""
	        ${3:close resource}
	        return True

snippet autoCloseableContextlib auto-closing resource class, implemented with the contextmanager decorator. import contextlib
	@contextlib.contextmanager
	def ${1:fun_name}():
	    # __enter__ method
	    resource = ${2:initialize resource}
	    try:
	        yield resource
	    finally:
	        # __exit__ method
	        ${3:close resource}

snippet autoCloseableClosing auto-closing resource class, implemented with the closing class. A class implementing close is closed automatically; use it via with contextlib.closing(test()) as var: (try_resources_contextlib_closing), import contextlib
	class ${1:class_name}(object):
	    def __init__(self):
	        ${2:initialize resource}
	    def close(self):
	        ${3:close resource}

