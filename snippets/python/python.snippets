# #Exceptions (error)
snippet errorClass custom exception class
	class ${1:err_class_name}(Exception):
	    def __init__(self, message: str) -> None:
		    super().__init__(message)
	    def __init__(self, e :Exception ,message: str) -> None:
	        super().__init__(e,message)

snippet errorNote add a note to an exception
	${1:error_name}.add_note("${2:message}")

# ##Exception chaining#Exceptions
# ```python
# # The raise statement allows an optional from clause, which enables chaining exceptions; chaining
# happens automatically when an exception is raised inside an except or finally section. This can be
# disabled with from None.
# try:
#     func()
# except ConnectionError as exc:
#     raise RuntimeError('Failed to open database') from exc # also prints the traceback of func();
#     if you don't want it, use raise RuntimeError from None
# ```
# ##ExceptionGroup#Exceptions
# The built-in ExceptionGroup wraps a list of exception instances so that they can be raised
# together. It is an exception itself, so it can be caught like any other exception.
# ```python
# def f():
#     excs = [OSError('error 1'), SystemError('error 2')]
#     raise ExceptionGroup('there were problems', excs)
# # + Exception Group Traceback (most recent call last):
# # |   File "<stdin>", line 1, in <module>
# # |   File "<stdin>", line 3, in f
# # | ExceptionGroup: there were problems
# # +-+---------------- 1 ----------------
# #   | OSError: error 1
# #   +---------------- 2 ----------------
# #   | SystemError: error 2
# #   +------------------------------------
# ```

