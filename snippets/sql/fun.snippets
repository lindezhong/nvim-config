snippet group_concat concat a field when using group by
	GROUP_CONCAT(${1:column})

snippet concat Join two strings
	CONCAT(${1:arg1}, ${2:arg2})

snippet length Get the length of a string
	LENGTH(${1:string})

snippet lower Convert to lowercase
	LOWER(${1:string})

snippet upper Convert to uppercase
	UPPER(${1:string})

snippet substring Extract a substring. SELECT SUBSTRING('Hello World', 1, 5);  -- returns 'Hello'
	SUBSTRING(${1:string}, ${2:start}, ${3:length})

snippet trim
	TRIM(${1:string})

snippet replace
	REPLACE(${1:string}, ${2:find}, ${3:replace})

snippet abs ABS(): returns the absolute value.
	ABS(${1:number})

snippet round ROUND(): round half up. SELECT ROUND(123.4567, 2);  -- returns 123.46
	ROUND(${1:number}, ${2:decimals})

snippet floor FLOOR(): round down. SELECT FLOOR(12.34);  -- returns 12
	FLOOR(${1:number})

snippet ceil round up, SELECT CEIL(12.34);  -- returns 13
	CEIL(${1:number})

snippet rand returns a random float between 0 and 1
	RAND()

snippet curdate returns the current date, in YYYY-MM-DD format
	CURDATE()

snippet now returns the current date and time. YYYY-MM-DD HH:MM:SS format
	NOW()

snippet date_add DATE_ADD(): add a given interval to a date, SELECT DATE_ADD('2023-01-01', INTERVAL 10 DAY);  -- returns '2023-01-11'
	DATE_ADD(${1:date}, INTERVAL ${2:value} ${3:unit})

snippet date_sub subtract a given interval from a date. SELECT DATE_SUB('2023-01-11', INTERVAL 10 DAY);  -- returns '2023-01-01'
	DATE_SUB(${1:date}, INTERVAL ${2:value} ${3:unit})

snippet datediff returns the number of days between two dates, SELECT DATEDIFF('2023-01-11', '2023-01-01');  -- returns 10
	DATEDIFF(${1:end_date}, ${2:start_date})

snippet count
	COUNT(${1:*})

snippet sum
	SUM(${1:column})

snippet avg
	AVG(${1:column})

snippet max
	MAX(${1:column})

snippet min
	MIN(${1:column})

# MySQL Control Flow Functions
snippet if
	IF(${1:condition}, ${2:true_value}, ${3:false_value})

snippet case
	CASE
		WHEN ${1:condition} THEN ${2:value}
		WHEN ${3:condition} THEN ${4:value}
		ELSE ${5:default_value}
	END AS ${6:alias}
