snippet createMysqlTable basic create table statement
	CREATE TABLE \`${1:table}\` (
	  \`id\` BIGINT PRIMARY KEY NOT NULL AUTO_INCREMENT COMMENT 'primary key',
	  \`gmt_create\` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT 'creation time',
	  \`gmt_modified\` DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT 'update time',
	  \`is_deleted\` TINYINT DEFAULT '0' COMMENT 'logical delete 0: not deleted 1: deleted',
	  ${0}
	) ENGINE=InnoDB AUTO_INCREMENT=84 DEFAULT CHARSET=utf8mb4 COMMENT='${2:comment}';

snippet columnMysqlTinyint int type TINYINT takes 1 byte, range -128 to 127 (signed) or 0 to 255 (unsigned)
	\`${1:column_name}\` TINYINT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlSmallint int type SMALLINT takes 2 bytes, range -32,768 to 32,767 (signed) or 0 to 65,535 (unsigned)
	\`${1:column_name}\` SMALLINT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlMediumint int type MEDIUMINT takes 3 bytes, range -8,388,608 to 8,388,607 (signed) or 0 to 16,777,215 (unsigned).
	\`${1:column_name}\` MEDIUMINT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlInt int type INT takes 4 bytes, range -2,147,483,648 to 2,147,483,647 (signed) or 0 to 4,294,967,295 (unsigned).
	\`${1:column_name}\` INT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlBigint int type BIGINT takes 8 bytes, range -9,223,372,036,854,775,808 to 9,223,372,036,854,775,807 (signed) or 0 to 18,446,744,073,709,551,615 (unsigned).
	\`${1:column_name}\` BIGINT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlFloat float type FLOAT takes 4 bytes, range  -3,402,823,466 to 3,402,823,466, mantissa limited to 7 digits
	\`${1:column_name}\` FLOAT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlDouble float type DOUBLE takes 8 bytes, range  -3,402,823,466 to 3,402,823,466, mantissa limited to 15 digits
	\`${1:column_name}\` DOUBLE NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlDecimal float type DECIMAL(M,D), DECIMAL(M, D), where M is the total number of digits and D the number of decimal places. Takes at most 65 bytes; D: at most 65.
	\`${1:column_name}\` DECIMAL(${3:10}, ${4:2}) NOT NULL DEFAULT '${5:0}' COMMENT '${2:comment}'$0

snippet columnMysqlChar str type CHAR(M), fixed-length string, max length 255 characters, i.e. M is at most 255
	\`${1:column_name}\` CHAR(${3:64}) NOT NULL DEFAULT '${4:0}' COMMENT '${2:comment}'$0

snippet columnMysqlVarchar str type VARCHAR(M), variable-length string, max length 65,535 characters (limited by row size). For M > 1024 a text type is recommended
	\`${1:column_name}\` VARCHAR(${3:64}) NOT NULL DEFAULT '${4:0}' COMMENT '${2:comment}'$0

snippet columnMysqlTinytext str type TINYTEXT, max length 255 characters
	\`${1:column_name}\` TINYTEXT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlText str type TEXT, max length 265,535 characters
	\`${1:column_name}\` TEXT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlMediumtext str type MEDIUMTEXT, max length 16,777,215 characters
	\`${1:column_name}\` MEDIUMTEXT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlLongtext str type LONGTEXT, max length 4,294,967,295 characters
	\`${1:column_name}\` LONGTEXT NOT NULL DEFAULT '${3:0}' COMMENT '${2:comment}'$0

snippet columnMysqlBinary byte type BINARY(M), fixed-length binary string
	\`${1:column_name}\` BINARY(${3:64}) NOT NULL DEFAULT '${4:0}' COMMENT '${2:comment}'$0

snippet columnMysqlVarbinary byte type VARBINARY(M), variable-length binary string.
	\`${1:column_name}\` VARBINARY(${3:64}) NOT NULL DEFAULT '${4:0}' COMMENT '${2:comment}'$0

snippet columnMysqlTinyblob byte type TINYBLOB, max length 255 bytes
	\`${1:column_name}\` TINYBLOB NULL COMMENT '${2:comment}'$0

snippet columnMysqlBlob byte type BLOB,  binary object up to 65,535 bytes.
	\`${1:column_name}\` BLOB NULL COMMENT '${2:comment}'$0

snippet columnMysqlMediumblob byte type MEDIUMBLOB, binary object up to 16,777,215 bytes.
	\`${1:column_name}\` MEDIUMBLOB NULL COMMENT '${2:comment}'$0

snippet columnMysqlLongblob byte type LONGBLOB, binary object up to 4,294,967,295 bytes.
	\`${1:column_name}\` LONGBLOB NULL COMMENT '${2:comment}'$0

snippet columnMysqlDate date type DATE, date, format YYYY-MM-DD.
	\`${1:column_name}\` DATE NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlDateUpdate date type DATE, auto-updated on update, date, format YYYY-MM-DD.
	\`${1:column_name}\` DATE NOT NULL CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlYear date type YEAR(4),  year, format YYYY
	\`${1:column_name}\` YEAR(4) NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlYearUpdate date type YEAR(4), auto-updated on update, year, format YYYY
	\`${1:column_name}\` YEAR(4) NOT NULL CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlTime date type TIME, time, format HH:MM:SS.
	\`${1:column_name}\` TIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlTimeUpdate date type TIME, auto-updated on update, time, format HH:MM:SS.
	\`${1:column_name}\` TIME NOT NULL CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlDatetime date type DATETIME, date and time, format YYYY-MM-DD HH:MM:SS.
	\`${1:column_name}\` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlDatetimeUpdate date type DATETIME, auto-updated on update, date and time, format YYYY-MM-DD HH:MM:SS.
	\`${1:column_name}\` DATETIME NOT NULL CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlTimestamp date type TIMESTAMP, timestamp, standard format
	\`${1:column_name}\` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlTimestampUpdate date type TIMESTAMP, auto-updated on update, timestamp, standard format
	\`${1:column_name}\` TIMESTAMP NOT NULL CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '${2:comment}'$0

snippet columnMysqlEnum enum type ENUM('enum1', 'enum2'), string object defining a list of allowed values
	\`${1:column_name}\` ENUM(${3:enums}) NOT NULL DEFAULT '${4:enum}' COMMENT '${2:comment}'$0

snippet columnMysqlSet set type SET('value1', 'value2'), defines a list of allowed values; one or more values are allowed.
	\`${1:column_name}\` SET(${3:value}) NOT NULL DEFAULT '${4:value1,value2}' COMMENT '${2:comment}'$0

snippet columnMysqlJson json type JSON, use column->'$.key' to query fields inside the json 
	\`${1:column_name}\` JSON NOT NULL DEFAULT '${4:{}}' COMMENT '${2:comment}'$0

snippet columnMysqlAddAfter add a column after another column, example ALTER TABLE table ADD column VARCHAR(100) COMMENT 'comment' AFTER last_column;
	ALTER TABLE \`${1:table}\`
	ADD ${3:column} AFTER ${2:last_column};

snippet columnMysqlAdd add a column at the end of the table, example ALTER TABLE table ADD column VARCHAR(100) COMMENT 'comment';
	ALTER TABLE \`${1:table}\`
	ADD ${2:column} ;

snippet columnMysqlAlter modify a column, example ALTER TABLE table MODIFY column VARCHAR(100) COMMENT 'comment';
	ALTER TABLE \`${1:table}\`
	MODIFY ${2:column} ;

snippet indexMysqlAdd add a normal index; a normal index may contain duplicate values and improves query performance on that column
	CREATE INDEX idx_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});

snippet indexMysqlAddUnique add a unique index; a unique index is like a normal index but does not allow duplicate values in the column
	CREATE UNIQUE INDEX uniq_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});

snippet indexMysqlAddFulltext add a fulltext index; fulltext indexes can only be added to text columns and are used via MATCH (title, content) AGAINST ('FULLTEXT search')
	CREATE FULLTEXT INDEX ft_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});

snippet indexMysqlAddSpatial add a spatial index, used via spatial functions such as ST_Within(), ST_Contains() and ST_Distance()
	CREATE SPATIAL INDEX sp_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});
