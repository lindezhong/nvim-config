snippet createSqliteTable basic create table statement
	CREATE TABLE ${1:table} 
	-- ${2:comment}
	(
	  id INTEGER PRIMARY KEY AUTOINCREMENT, -- primary key
	  gmt_create TEXT DEFAULT (datetime('now', 'localtime')) NOT NULL,  -- creation time
	  gmt_modified TEXT DEFAULT (datetime('now', 'localtime')) NOT NULL, -- update time
	  is_deleted INTEGER DEFAULT '0', -- logical delete 0: not deleted 1: deleted
	  $0
	);

snippet columnSqliteNull null type NULL, a field with no value
	${1:column_name} NULL -- ${2:comment}$0

snippet columnSqliteInteger int type INTEGER, stores integers; storage size is 1 to 8 bytes depending on the magnitude of the value.
	${1:column_name} INTEGER NOT NULL DEFAULT '${2:0}' -- ${3:comment}$0

snippet columnSqliteReal float type REAL, stores floating-point numbers (reals), usually 8 bytes (double precision).
	${1:column_name} REAL NOT NULL DEFAULT '${2:0}' -- ${3:comment}$0

snippet columnSqliteText str type TEXT, stores text strings of any size, actually stored in UTF-8 or UTF-16 encoding.
	${1:column_name} TEXT NOT NULL DEFAULT '${2:}' -- ${3:comment}$0

snippet columnSqliteBlob byte type BLOB, stores binary data (Binary Large Object) of any size.
	${1:column_name} TEXT NOT NULL DEFAULT '${2:}' -- ${3:comment}$0

snippet columnSqliteDatetime SQLite has no separate storage class for dates and/or times, but SQLite can store dates and times as TEXT (dates in the format YYYY-MM-DD HH:MM:SS.SSS), REAL (number of days since noon in Greenwich on November 24, 4714 B.C.) or INTEGER (number of seconds since 1970-01-01 00:00:00 UTC) values
	columnSqliteText

snippet columnSqliteAddAfter add a column after another column, example ALTER TABLE table ADD column TEXT COMMENT 'comment' AFTER last_column;
	ALTER TABLE ${1:table}
	ADD ${3:column} AFTER ${2:last_column};

snippet columnSqliteAdd add a column at the end of the table, example ALTER TABLE table ADD column TEXT COMMENT 'comment';
	ALTER TABLE ${1:table}
	ADD ${2:column} ;

snippet columnSqliteAlter modify a column, example ALTER TABLE table MODIFY column TEXT COMMENT 'comment';
	ALTER TABLE ${1:table}
	MODIFY ${2:column} ;

snippet indexSqliteAdd add a normal index; a normal index may contain duplicate values and improves query performance on that column
	CREATE INDEX idx_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});

snippet indexSqliteAddUnique add a unique index; a unique index is like a normal index but does not allow duplicate values in the column
	CREATE UNIQUE INDEX uniq_${3:index_name_is_column_name_list} ON ${1:table_name} (${2:column_name});
